---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Manchas from '../components/Manchas.astro';
import {
  LOCALE_HTML,
  LOCALE_OG,
  idiomaDesdeUrl,
  resolverAlterna,
  t,
  type Idioma,
} from '../i18n';
// La letra de los titulares se ve en el primer pantallazo: se precarga.
import letraTitulares from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir: /og/<og>.png (ver src/data/og.ts). */
  og?: string;
  /** false en páginas que no deben salir en buscadores (por ejemplo /sin-conexion/). */
  indexable?: boolean;
  /** Idioma de la página; si se omite, se deduce de la ruta. */
  idioma?: Idioma;
}

const { title, description, og = 'inicio', indexable = true, idioma: idiomaProp } = Astro.props;
const idioma: Idioma = idiomaProp ?? idiomaDesdeUrl(Astro.url);
const txt = t(idioma);
const otroIdioma: Idioma = idioma === 'es' ? 'en' : 'es';
const alterna = resolverAlterna(Astro.url.pathname, otroIdioma);

const titulo = title === txt.sitio.nombre ? title : `${title} | ${txt.sitio.nombre}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(`/og/${og}.png`, Astro.site);
const urlEs = idioma === 'es' ? canonica : new URL(alterna.href, Astro.site);
const urlEn = idioma === 'en' ? canonica : new URL(alterna.href, Astro.site);
---

<!doctype html>
<html lang={LOCALE_HTML[idioma]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/iconos/icono-apple-180.png" />
    <link rel="preload" as="font" type="font/woff2" href={letraTitulares} crossorigin />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonica} />
    {
      indexable && alterna.existe && (
        <>
          <link rel="alternate" hreflang="es-PE" href={urlEs} />
          <link rel="alternate" hreflang="en" href={urlEn} />
          <link rel="alternate" hreflang="x-default" href={urlEs} />
        </>
      )
    }
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#13185a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={txt.sitio.nombre} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={txt.sitio.ogAlt(title)} />
    <meta property="og:locale" content={LOCALE_OG[idioma]} />
    {alterna.existe && <meta property="og:locale:alternate" content={LOCALE_OG[otroIdioma]} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagen} />
    <title>{titulo}</title>
    <Analytics />
  </head>
  <body>
    <Cabecera idioma={idioma} />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} />
    <Manchas />
    <!-- Se llena solo cuando no hay conexión -->
    <p class="sin-red" role="status" data-sin-red></p>
    <!-- Solo en el teléfono, y solo si el navegador puede instalar la web (src/lib/instalar.ts) -->
    <div class="instalar-flotante" data-instalar-flotante hidden>
      <button type="button" class="instalar-flotante__boton" data-flotante-instalar>{txt.instalar.flotante}</button>
      <button type="button" class="instalar-flotante__cerrar" data-flotante-cerrar aria-label={txt.instalar.cerrarAria}>
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </body>
</html>

<script>
  import { alCambiar, disponible, instalar } from '../lib/instalar';
  import { idiomaEnNavegador, t } from '../i18n';

  const txt = t(idiomaEnNavegador());

  // Recordar la elección manual de idioma (sin redirigir automáticamente)
  document.querySelectorAll<HTMLAnchorElement>('[data-cambiar-idioma]').forEach((enlace) => {
    enlace.addEventListener('click', () => {
      try {
        localStorage.setItem('carnaval-idioma', enlace.dataset.cambiarIdioma ?? 'es');
      } catch {
        // Sin almacenamiento disponible
      }
    });
  });

  // Botón flotante de instalar: si lo cierran, no vuelve a salir por dos semanas
  const flotante = document.querySelector<HTMLElement>('[data-instalar-flotante]');
  const CLAVE = 'instalar-oculto';
  const ocultoHasta = () => {
    try {
      return Number(localStorage.getItem(CLAVE)) || 0;
    } catch {
      return 0;
    }
  };
  if (flotante) {
    const botonInstalar = flotante.querySelector<HTMLButtonElement>('[data-flotante-instalar]')!;
    alCambiar(() => {
      flotante.hidden = !disponible() || Date.now() < ocultoHasta();
    });
    botonInstalar.addEventListener('click', async () => {
      if (botonInstalar.getAttribute('aria-disabled') === 'true') return;
      botonInstalar.setAttribute('aria-disabled', 'true');
      await instalar();
      botonInstalar.removeAttribute('aria-disabled');
    });
    flotante.querySelector('[data-flotante-cerrar]')?.addEventListener('click', () => {
      try {
        localStorage.setItem(CLAVE, String(Date.now() + 14 * 86_400_000));
      } catch {
        // Sin almacenamiento: se oculta solo hasta la próxima página
      }
      flotante.hidden = true;
    });
  }

  const aviso = document.querySelector<HTMLElement>('[data-sin-red]');
  const estado = document.querySelector<HTMLElement>('[data-guardado]');
  const servicio = import.meta.env.PROD && navigator.serviceWorker;
  let anunciada = Boolean(servicio && servicio.controller);
  let temporizador = 0;

  function revisarRed(mensaje = '') {
    const listo = Boolean(servicio && servicio.controller);
    if (estado && servicio) {
      estado.textContent = listo ? txt.sinRed.listo : mensaje || txt.sinRed.guardando;
    }
    if (!aviso) return;
    window.clearTimeout(temporizador);
    if (!navigator.onLine) {
      aviso.textContent = listo ? txt.sinRed.offlineListo : txt.sinRed.offlinePendiente;
    } else if (listo && !anunciada) {
      anunciada = true;
      aviso.textContent = txt.sinRed.listo;
      temporizador = window.setTimeout(() => { aviso.textContent = ''; }, 5000);
    } else {
      aviso.textContent = '';
    }
  }

  let registrando = false;
  async function guardar() {
    if (!servicio || !navigator.onLine || registrando) return;
    registrando = true;
    try {
      const registro = await servicio.register('/sw.js');
      const vigilar = () => {
        const trabajador = registro.installing;
        trabajador?.addEventListener('statechange', () => {
          if (trabajador.state === 'redundant') revisarRed(txt.sinRed.reintentar);
        });
      };
      vigilar();
      registro.addEventListener('updatefound', vigilar, { once: true });
      revisarRed();
    } catch (error) {
      revisarRed(txt.sinRed.reintentar);
      console.error('No se pudo guardar la web', error);
    } finally {
      registrando = false;
    }
  }

  if (servicio) {
    servicio.addEventListener('controllerchange', () => revisarRed());
    document.addEventListener('visibilitychange', async () => {
      if (document.hidden || !navigator.onLine) return;
      const registro = await servicio.getRegistration();
      if (registro?.active) await registro.update().catch(() => {});
    });
  }
  addEventListener('online', () => { revisarRed(); void guardar(); });
  addEventListener('offline', () => revisarRed());
  revisarRed();
  void guardar();
</script>
