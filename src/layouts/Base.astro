---
import '@fontsource-variable/big-shoulders-display';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Cabecera from '../components/Cabecera.astro';
import Pie from '../components/Pie.astro';
import Manchas from '../components/Manchas.astro';
// La letra de los titulares se ve en el primer pantallazo: se precarga.
import letraTitulares from '@fontsource-variable/big-shoulders-display/files/big-shoulders-display-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir: /og/<og>.png (ver src/data/og.ts). */
  og?: string;
  /** false en páginas que no deben salir en buscadores (por ejemplo /sin-conexion/). */
  indexable?: boolean;
}

const { title, description, og = 'inicio', indexable = true } = Astro.props;
const titulo = title === 'Carnaval de Cajamarca' ? title : `${title} | Carnaval de Cajamarca`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagen = new URL(`/og/${og}.png`, Astro.site);
---

<!doctype html>
<html lang="es-PE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/iconos/icono-apple-180.png" />
    <link rel="preload" as="font" type="font/woff2" href={letraTitulares} crossorigin />
    {!indexable && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonica} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#13185a" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Carnaval de Cajamarca" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title}: afiche del Carnaval de Cajamarca`} />
    <meta property="og:locale" content="es_PE" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagen} />
    <title>{titulo}</title>
    <Analytics />
  </head>
  <body>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    <Manchas />
    <!-- Se llena solo cuando no hay conexión -->
    <p class="sin-red" role="status" data-sin-red></p>
  </body>
</html>

<script>
  // Guarda la web en el teléfono para usarla sin señal (integraciones/sin-conexion).
  // Solo en el build: en desarrollo no se guarda nada, para ver siempre lo último.
  if (import.meta.env.PROD && 'serviceWorker' in navigator) {
    navigator.serviceWorker.register('/sw.js').catch((error) => console.error('No se pudo guardar la web', error));
  }

  // Aviso cuando se pierde la señal
  const aviso = document.querySelector<HTMLElement>('[data-sin-red]');
  const revisarRed = () => {
    if (aviso) aviso.textContent = navigator.onLine ? '' : 'Sin conexión: estás viendo lo guardado en tu teléfono.';
  };
  addEventListener('online', revisarRed);
  addEventListener('offline', revisarRed);
  revisarRed();
</script>
