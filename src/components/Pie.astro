---
import Chicha from './Chicha.astro';
import { creditoFotos } from '../data/fotos';
import SelectorIdioma from './SelectorIdioma.astro';
import { idiomaDesdeUrl, rutaDe, t, type Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}

const idioma: Idioma = Astro.props.idioma ?? idiomaDesdeUrl(Astro.url);
const txt = t(idioma);
const licenciaUrl = idioma === 'en' ? creditoFotos.licenciaUrl.replace('/deed.es', '/deed.en') : creditoFotos.licenciaUrl;
---

<footer class="pie zigzag-arriba">
  <div class="envoltura pie__grid">
    <div>
      <Chicha
        texto={txt.pie.grito}
        como="p"
        class="pie__grito"
        relleno="var(--amarillo)"
        relleno2="var(--naranja)"
        sombra="var(--azul)"
        lang="es"
      />
      <p class="pie__nota">{txt.pie.nota}</p>
      <SelectorIdioma idioma={idioma} lugar="pie" />
    </div>
    <nav aria-label={txt.pie.navAria} class="pie__nav">
      <a href={rutaDe('2027', idioma)}>{txt.pie.carnaval2027}</a>
      <a href={rutaDe('guia', idioma)}>{txt.nav.items.guia}</a>
      <a href={rutaDe('la-fiesta', idioma)}>{txt.nav.items['la-fiesta']}</a>
      <a href={rutaDe('ediciones', idioma)}>{txt.nav.items.ediciones}</a>
      <a href={rutaDe('barrios', idioma)}>{txt.nav.items.barrios}</a>
      <a href={rutaDe('coplas', idioma)}>{txt.nav.items.coplas}</a>
      <a href={rutaDe('habla', idioma)}>{txt.nav.items.habla}</a>
      <a href={rutaDe('historia', idioma)}>{txt.nav.items.historia}</a>
    </nav>
  </div>
  <section class="envoltura" data-borradores-whatsapp hidden aria-label={txt.pie.borradoresTitulo}>
    <h2>{txt.pie.borradoresTitulo}</h2>
    <ul></ul>
  </section>
  <p class="envoltura pie__creditos">
    {txt.pie.fotos} {creditoFotos.autor},{' '}
    <a href={creditoFotos.categoriaUrl}>Wikimedia Commons</a>,{' '}
    <a href={licenciaUrl}>{creditoFotos.licencia}</a>.{' '}
    <a href={rutaDe('fuentes', idioma)}>{txt.pie.fuentesYCreditos}</a>.
  </p>
</footer>

<style>
  .pie {
    position: relative;
    padding-block: calc(clamp(3.5rem, 7vw, 5rem) + var(--zz)) 2.5rem;
    background: var(--fucsia);
    --zz-color: var(--fucsia);
    color: var(--tinta);
  }

  .pie a {
    text-decoration-color: var(--tinta);
  }

  .pie__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2.5rem;
    align-items: start;
  }

  .pie :global(.pie__grito) {
    font-size: clamp(3.2rem, 9vw, 6.5rem);
  }

  .pie__nota {
    max-width: 44ch;
    margin-top: 1.5rem;
    font-weight: 500;
  }

  .pie__nav {
    display: grid;
    gap: 0.2rem;
    justify-items: start;
  }

  .pie__nav a {
    font-family: var(--display);
    font-weight: 900;
    font-size: 2rem;
    text-transform: uppercase;
    text-decoration: none;
    line-height: 1.15;
  }

  .pie__nav a:hover {
    color: var(--blanco);
  }

  .pie__creditos {
    margin-top: 3rem;
    padding-top: 1.2rem;
    border-top: 3px solid var(--tinta);
    font-size: 0.95rem;
    font-weight: 500;
  }

  @media (max-width: 760px) {
    .pie__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { idiomaEnNavegador, t } from '../i18n';

  const txt = t(idiomaEnNavegador()).pie;
  const panel = document.querySelector<HTMLElement>('[data-borradores-whatsapp]');
  const lista = panel?.querySelector('ul');
  const clave = 'carnaval-borradores-whatsapp';

  function enlaceValido(href: string) {
    try {
      const url = new URL(href);
      return url.origin === 'https://wa.me' && Boolean(url.searchParams.get('text'));
    } catch {
      return false;
    }
  }

  function leerBorradores(): string[] {
    try {
      const guardados: unknown = JSON.parse(localStorage.getItem(clave) ?? '[]');
      if (!Array.isArray(guardados)) return [];
      return guardados.filter((href) => typeof href === 'string' && enlaceValido(href));
    } catch {
      return [];
    }
  }

  const borradores = new Set(leerBorradores());

  function persistir() {
    try {
      localStorage.setItem(clave, JSON.stringify([...borradores]));
      return true;
    } catch {
      return false;
    }
  }

  function mostrar() {
    if (!panel || !lista) return;
    panel.hidden = borradores.size === 0;
    lista.replaceChildren();
    for (const href of borradores) {
      const fila = document.createElement('li');
      const mensaje = new URL(href).searchParams.get('text');
      const enlace = document.createElement(navigator.onLine ? 'a' : 'span');
      enlace.textContent = mensaje;
      if (enlace instanceof HTMLAnchorElement) {
        enlace.href = href;
        enlace.target = '_blank';
        enlace.rel = 'noopener';
      }
      const quitar = document.createElement('button');
      quitar.type = 'button';
      quitar.textContent = txt.quitar;
      quitar.setAttribute('aria-label', txt.quitarBorradorAria + mensaje);
      quitar.addEventListener('click', () => {
        borradores.delete(href);
        persistir();
        mostrar();
      });
      fila.append(enlace, ' ', quitar);
      lista.append(fila);
    }
  }

  document.addEventListener('click', (evento) => {
    const enlace = evento.target instanceof Element && evento.target.closest<HTMLAnchorElement>('a[href]');
    if (evento.defaultPrevented || navigator.onLine || !enlace || !enlaceValido(enlace.href)) return;
    evento.preventDefault();
    borradores.add(enlace.href);
    const guardado = persistir();
    mostrar();
    const aviso = document.querySelector('[data-sin-red]');
    if (aviso) {
      aviso.textContent = guardado ? txt.borradorGuardado : txt.borradorSinEspacio;
    }
  });

  addEventListener('online', mostrar);
  addEventListener('offline', mostrar);
  mostrar();
</script>
