---
/**
 * Cambio de idioma. Cada idioma se nombra en su propio idioma («Español», «English»),
 * sin banderas: el castellano no es de un solo país ni el inglés tampoco.
 *
 * - cabecera: en pantallas anchas se ve solo el otro idioma, como un botón más del menú,
 *   con un globito de diálogo con su código («EN», «ES»), inclinado como el sticker de 2027.
 *   Dentro del menú del teléfono se ven los dos, lado a lado.
 * - pie: los dos lado a lado; el actual va relleno.
 *
 * El clic lo recuerda Base.astro (data-cambiar-idioma); no se redirige solo.
 */
import { LOCALE_HTML, NOMBRE_IDIOMA, rutaAlterna, t, type Idioma } from '../i18n';

interface Props {
  idioma: Idioma;
  lugar: 'cabecera' | 'pie';
}

const { idioma, lugar } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/?$/, '/');
const opciones = (['es', 'en'] as const).map((id) => ({
  id,
  nombre: NOMBRE_IDIOMA[id],
  actual: id === idioma,
  href: id === idioma ? ruta : rutaAlterna(ruta, id),
}));
---

<div class:list={['idioma', `idioma--${lugar}`]} role="group" aria-label={t(idioma).nav.idiomaAria}>
  {
    opciones.map((o) =>
      o.actual ? (
        <span class="idioma__opcion idioma__opcion--actual" lang={o.id} aria-current="true">
          {o.nombre}
        </span>
      ) : (
        <a class="idioma__opcion" href={o.href} hreflang={LOCALE_HTML[o.id]} lang={o.id} data-cambiar-idioma={o.id}>
          <span class="idioma__burbuja" aria-hidden="true">{o.id.toUpperCase()}</span>
          {o.nombre}
        </a>
      ),
    )
  }
</div>

<style>
  .idioma {
    display: inline-flex;
    font-family: var(--display);
    font-weight: 800;
    letter-spacing: 0.03em;
    line-height: 1;
    text-transform: uppercase;
  }

  .idioma__opcion {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4em;
    min-height: 44px;
    padding: 0.3em 0.75em 0.2em;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  /* Globito de diálogo con el código del idioma: «¿hablas EN?» */
  .idioma__burbuja {
    position: relative;
    flex: none;
    padding: 0.22em 0.32em 0.14em;
    border-radius: 0.2em;
    background: var(--amarillo);
    color: var(--tinta);
    font-size: 0.72em;
    font-weight: 900;
    letter-spacing: 0.04em;
    rotate: -6deg;
    translate: 0 -0.12em;
  }

  /* La colita del globito, abajo a la izquierda */
  .idioma__burbuja::after {
    position: absolute;
    left: 0.3em;
    bottom: -0.36em;
    border-top: 0.4em solid var(--amarillo);
    border-right: 0.45em solid transparent;
    content: '';
  }

  /* Cabecera, pantalla ancha: un solo botón con el otro idioma */
  .idioma--cabecera {
    font-size: 1.25rem;
  }

  .idioma--cabecera .idioma__opcion--actual {
    display: none;
  }

  .idioma--cabecera a {
    border: 2px solid rgb(255 255 255 / 0.5);
    color: var(--blanco);
  }

  .idioma--cabecera a:hover {
    border-color: var(--fucsia);
    background: var(--fucsia);
  }

  /* Menú del teléfono: los dos idiomas lado a lado, a todo el ancho */
  @media (max-width: 760px) {
    :global(.con-menu) .idioma--cabecera {
      display: flex;
      width: 100%;
      border: 2px solid rgb(255 255 255 / 0.4);
      font-size: 1.45rem;
    }

    :global(.con-menu) .idioma--cabecera .idioma__opcion {
      display: inline-flex;
      flex: 1;
      min-height: 52px;
      border: 0;
    }

    :global(.con-menu) .idioma--cabecera .idioma__opcion--actual {
      background: var(--amarillo);
      color: var(--tinta);
    }

    :global(.con-menu) .idioma--cabecera .idioma__burbuja {
      display: none;
    }
  }

  /* Pie: los dos idiomas lado a lado sobre el fucsia */
  .idioma--pie {
    margin-top: 1.2rem;
    border: 3px solid var(--tinta);
    font-size: 1.35rem;
    font-weight: 900;
  }

  .idioma--pie .idioma__opcion {
    padding-inline: 0.9em;
  }

  .idioma--pie .idioma__opcion--actual {
    background: var(--tinta);
    color: var(--amarillo);
  }

  .idioma--pie a {
    background: var(--blanco);
    color: var(--tinta);
  }

  .idioma--pie a:hover {
    background: var(--amarillo);
  }

  .idioma--pie .idioma__burbuja {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .idioma__opcion {
      transition: none;
    }
  }
</style>
