---
/**
 * Pintura por toda la web: cada sección (y el pie) lleva una a tres manchas en los
 * bordes —salpicones, manos, globos reventados, chorreados, brochazos, talco—
 * que aparecen al bajar, como si alguien acabara de pintar. Las formas están en
 * src/lib/manchas.ts. Son decoración: quedan detrás del texto y los lectores de
 * pantalla no las leen. Una sección con data-sin-manchas se queda limpia.
 */
---

<style is:global>
  .con-manchas {
    position: relative;
    isolation: isolate;
  }

  /* clip y no hidden: hidden la volvería contenedor de scroll y la animación no avanzaría */
  .manchas {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: clip;
    pointer-events: none;
  }

  .mancha-deco {
    position: absolute;
    opacity: 0.92;
  }

  /* El centro y las gotas crecen desde el medio de la mancha (0,0 de su viewBox):
     así las gotas salen volando hacia afuera */
  .mancha-deco .centro,
  .mancha-deco .gota,
  .capa-pintura .mancha .centro,
  .capa-pintura .mancha .gota {
    transform-box: view-box;
    transform-origin: 0 0;
  }

  /* Cada mancha se pinta cuando aparece en pantalla (la marca el script con
     .pintada): el salpicón revienta y suelta sus gotas, la mano se estampa,
     el chorreado cae, el brochazo se pinta de una pasada y el talco se abre.
     Con «reducir movimiento», ya están pintadas desde el principio. */
  @media (prefers-reduced-motion: no-preference) {
    .mancha-deco[data-espera] {
      visibility: hidden;
    }

    .mancha-deco.pintada .centro {
      animation: mancha-revienta 0.42s cubic-bezier(0.2, 1.6, 0.4, 1) var(--retraso, 0s) both;
    }

    .mancha-deco.pintada .gota,
    .capa-pintura .mancha .gota {
      animation: mancha-vuela 0.5s cubic-bezier(0.12, 0.9, 0.3, 1.15) calc(var(--retraso, 0s) + var(--d, 0s)) both;
    }

    .mancha-deco--mano.pintada {
      animation: mancha-estampa 0.55s cubic-bezier(0.3, 1.5, 0.5, 1) var(--retraso, 0s) both;
    }

    .mancha-deco--chorreado.pintada {
      animation: mancha-chorrea 1.3s cubic-bezier(0.55, 0, 0.7, 1) var(--retraso, 0s) both;
    }

    .mancha-deco--brochazo.pintada {
      animation: mancha-pinta 0.8s cubic-bezier(0.45, 0, 0.2, 1) var(--retraso, 0s) both;
    }
  }

  @keyframes mancha-revienta {
    from {
      scale: 0;
    }
  }

  @keyframes mancha-vuela {
    from {
      opacity: 0;
      scale: 0.15;
    }
  }

  @keyframes mancha-estampa {
    from {
      opacity: 0;
      scale: 1.5;
    }
    60% {
      opacity: 0.92;
      scale: 0.93;
    }
  }

  /* La pintura baja desde el borde, como cae de verdad */
  @keyframes mancha-chorrea {
    from {
      clip-path: inset(0 0 100% 0);
    }
  }

  @keyframes mancha-pinta {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }
</style>

<script>
  import { azarConSemilla, crearMancha, PROPORCION, semillaDe, type TipoMancha } from '../lib/manchas';

  const PALETA = ['#ff2a92', '#ffe600', '#00b35c', '#1d2fd0', '#ff6a00', '#00b8c8', '#ffffff'];
  /** Ancho de cada forma en la computadora (en el teléfono va más chica). */
  const ANCHO: Record<TipoMancha, number> = {
    salpicon: 230,
    mano: 150,
    globo: 210,
    chorreado: 360,
    brochazo: 380,
    talco: 200,
  };

  type Rgb = [number, number, number];
  const hexARgb = (hex: string): Rgb => [1, 3, 5].map((i) => parseInt(hex.slice(i, i + 2), 16)) as Rgb;
  const leerRgb = (css: string): Rgb | null => {
    const n = css.match(/[\d.]+/g)?.map(Number);
    if (!n || n.length < 3 || n[3] === 0) return null;
    return [n[0], n[1], n[2]];
  };
  const luz = ([r, g, b]: Rgb) => (0.2126 * r + 0.7152 * g + 0.0722 * b) / 255;
  const distancia = (a: Rgb, b: Rgb) => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);

  /** Color de fondo real: el de la sección o, si es transparente, el de más afuera. */
  function fondoDe(el: Element | null): Rgb {
    for (; el; el = el.parentElement) {
      const c = leerRgb(getComputedStyle(el).backgroundColor);
      if (c) return c;
    }
    return [255, 255, 255];
  }

  function elegirTipo(azar: () => number, primera: boolean, fondoClaro: boolean): TipoMancha {
    const opciones: [TipoMancha, number][] = [
      ['salpicon', 3],
      ['mano', 3],
      ['globo', 2],
      ['brochazo', 2],
      ['chorreado', primera ? 2 : 0],
      ['talco', fondoClaro ? 0 : 1],
    ];
    let tiro = azar() * opciones.reduce((s, [, peso]) => s + peso, 0);
    for (const [tipo, peso] of opciones) {
      tiro -= peso;
      if (tiro < 0) return tipo;
    }
    return 'salpicon';
  }

  function decorar(seccion: HTMLElement, indice: number) {
    const alto = seccion.offsetHeight;
    if (alto < 220 || seccion.hasAttribute('data-sin-manchas')) return;
    const movil = seccion.offsetWidth < 700;
    const azar = azarConSemilla(semillaDe(`${location.pathname}#${indice}`));
    const fondo = fondoDe(seccion);
    const fondoClaro = luz(fondo) > 0.85;
    // El texto pasa por encima: sobre letra clara no van colores claros, y al revés
    const textoClaro = luz(leerRgb(getComputedStyle(seccion).color) ?? [0, 0, 0]) > 0.6;
    const colores = PALETA.filter((c) => {
      const rgb = hexARgb(c);
      return distancia(rgb, fondo) > 140 && (textoClaro ? luz(rgb) < 0.62 : luz(rgb) > 0.3);
    });
    if (colores.length === 0) return;

    const cuantas = movil ? (alto < 700 ? 1 : 2) : alto < 650 ? 2 : alto < 1300 ? 3 : 4;
    // Margen real entre el borde y el texto: las manchas viven ahí y solo rozan el texto
    const envoltura = seccion.querySelector<HTMLElement>('.envoltura');
    const margen = envoltura
      ? envoltura.getBoundingClientRect().left - seccion.getBoundingClientRect().left
      : 40;
    const capa = document.createElement('div');
    capa.className = 'manchas';
    capa.setAttribute('aria-hidden', 'true');

    for (let k = 0; k < cuantas; k++) {
      const tipo = elegirTipo(azar, k === 0, fondoClaro);
      const color = tipo === 'talco' ? '#ffffff' : colores[Math.floor(azar() * colores.length)];
      const ancho = ANCHO[tipo] * (0.9 + azar() * 0.45) * (movil ? 0.6 : 1);
      const altoMancha = ancho * PROPORCION[tipo];
      const svg = crearMancha(tipo, color, ancho, azar);
      svg.classList.add('mancha-deco', `mancha-deco--${tipo}`);
      if (animar) {
        // Espera escondida hasta que se vea; las que aparecen juntas no salen al mismo tiempo
        svg.setAttribute('data-espera', '');
        svg.style.setProperty('--retraso', `${(k * 0.12 + Math.random() * 0.12).toFixed(2)}s`);
      }
      const izquierda = (indice + k) % 2 === 0;

      if (tipo === 'chorreado') {
        // Cuelga del borde de arriba
        svg.style.top = '0';
        svg.style.left = `${(izquierda ? 4 + azar() * 22 : 52 + azar() * 22).toFixed(1)}%`;
      } else {
        // En los márgenes, un poco salida de la sección; las que tocan el mismo lado
        // se reparten a lo alto para no encimarse
        const base = movil ? 0.5 : tipo === 'brochazo' ? 0.2 : 0.12 + azar() * 0.22;
        // Lo que se ve de la mancha no pasa mucho del margen (salvo que la mancha sea chica)
        const visible = Math.max(margen + 40, ancho * 0.3);
        const afuera = Math.max(base, 1 - visible / ancho);
        svg.style[izquierda ? 'left' : 'right'] = `${(-ancho * afuera).toFixed(0)}px`;
        const franja = 1 / cuantas;
        const desde = Math.max(0.06, k * franja);
        const hasta = Math.min(0.92, (k + 1) * franja);
        svg.style.top = `${((desde + azar() * (hasta - desde)) * 100).toFixed(1)}%`;
        svg.style.marginTop = `${(-altoMancha / 2).toFixed(0)}px`;
        svg.style.rotate = `${((azar() - 0.5) * (tipo === 'brochazo' ? 24 : 60)).toFixed(1)}deg`;
      }
      capa.append(svg);
    }

    seccion.classList.add('con-manchas');
    seccion.prepend(capa);
  }

  const animar =
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window;

  document.querySelectorAll<HTMLElement>('main .bloque, footer.pie').forEach(decorar);

  // Cada mancha se pinta cuando ya está a la vista (por encima del último 18 % de la
  // pantalla), no cuando apenas asoma por abajo: así se ve cómo cae la pintura
  if (animar) {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const entrada of entradas) {
          if (!entrada.isIntersecting) continue;
          entrada.target.removeAttribute('data-espera');
          entrada.target.classList.add('pintada');
          observador.unobserve(entrada.target);
        }
      },
      { rootMargin: '0px 0px -18% 0px', threshold: 0.15 },
    );
    document.querySelectorAll('.mancha-deco[data-espera]').forEach((m) => observador.observe(m));
  }
</script>
