---
/**
 * Cinta inclinada con gritos de la fiesta que corren de lado a lado.
 * Solo se mueve si el sistema no pide reducir movimiento, y se detiene
 * mientras el mouse está encima.
 */
interface Props {
  items: string[];
  color?: string;
  tinta?: string;
  giro?: number;
}

const { items, color = 'var(--amarillo)', tinta = 'var(--tinta)', giro = -2 } = Astro.props;
---

<div class="cinta claro" style={`--cinta:${color};--cinta-tinta:${tinta};--giro:${giro}deg`}>
  <p class="visualmente-oculto">{items.join('. ')}</p>
  <div class="cinta__pista" aria-hidden="true">
    {
      [0, 1].map(() => (
        <span class="cinta__tramo">
          {items.map((t) => (
            <span class="cinta__item">{t}</span>
          ))}
        </span>
      ))
    }
  </div>
</div>

<style>
  .cinta {
    position: relative;
    z-index: 2;
    margin-inline: -3vw;
    padding-block: 0.6rem;
    background: var(--cinta);
    color: var(--cinta-tinta);
    border-block: 4px solid var(--cinta-tinta);
    rotate: var(--giro);
    overflow: hidden;
  }

  .cinta__pista {
    display: flex;
    width: max-content;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cinta__pista {
      animation: correr 38s linear infinite;
    }

    .cinta:hover .cinta__pista {
      animation-play-state: paused;
    }
  }

  .cinta__tramo {
    display: flex;
    flex-shrink: 0;
  }

  .cinta__item {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-inline: 1rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cinta__item::after {
    content: '';
    width: 0.55em;
    aspect-ratio: 1;
    background: var(--fucsia);
    clip-path: polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }

  @keyframes correr {
    to {
      translate: -50% 0;
    }
  }
</style>
