---
/**
 * Juego de pintura: dentro de cualquier contenedor con [data-pintura],
 * tocar el fondo deja una mancha. Un botón con [data-jugar] lanza varias.
 * Las manchas quedan detrás del texto (capa [data-capa-pintura]).
 */
---

<style is:global>
  [data-pintura] {
    position: relative;
    isolation: isolate;
  }

  .capa-pintura {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .capa-pintura .mancha {
    position: absolute;
    overflow: visible;
  }

  @media (prefers-reduced-motion: no-preference) {
    .capa-pintura .mancha {
      animation: salpicar 0.3s cubic-bezier(0.2, 1.6, 0.4, 1) both;
    }
  }

  @keyframes salpicar {
    from {
      scale: 0.2;
      opacity: 0;
    }
  }
</style>

<script>
  import { crearMancha, PROPORCION, type TipoMancha } from '../lib/manchas';

  const COLORES = ['#ffe600', '#00b35c', '#1d2fd0', '#ff6a00', '#00b8c8', '#ffffff', '#13185a'];
  const MAX = 40;
  const azar = (a: number, b: number) => a + Math.random() * (b - a);
  // Al tocar salen salpicones, manos y globos reventados; la mano, un poco más chica
  const TIPOS: { tipo: TipoMancha; ancho: [number, number] }[] = [
    { tipo: 'salpicon', ancho: [150, 260] },
    { tipo: 'salpicon', ancho: [150, 260] },
    { tipo: 'mano', ancho: [110, 170] },
    { tipo: 'globo', ancho: [150, 240] },
  ];

  function salpicar(capa: HTMLElement, x: number, y: number) {
    const { tipo, ancho: rango } = TIPOS[Math.floor(Math.random() * TIPOS.length)];
    const ancho = azar(...rango);
    const alto = ancho * PROPORCION[tipo];
    const color = COLORES[Math.floor(Math.random() * COLORES.length)];
    const svg = crearMancha(tipo, color, ancho, Math.random);
    svg.classList.add('mancha');
    svg.style.left = `${x - ancho / 2}px`;
    svg.style.top = `${y - alto / 2}px`;
    // Las manos no salen de cabeza
    svg.style.rotate = `${tipo === 'mano' ? azar(-35, 35) : azar(0, 360)}deg`;
    capa.append(svg);
    while (capa.childElementCount > MAX) capa.firstElementChild?.remove();
  }

  document.querySelectorAll<HTMLElement>('[data-pintura]').forEach((zona) => {
    const capa = zona.querySelector<HTMLElement>('[data-capa-pintura]');
    if (!capa) return;
    zona.addEventListener('pointerdown', (e) => {
      if ((e.target as Element).closest('a, button, input')) return;
      const caja = zona.getBoundingClientRect();
      salpicar(capa, e.clientX - caja.left, e.clientY - caja.top);
    });
    zona.querySelector<HTMLButtonElement>('[data-jugar]')?.addEventListener('click', () => {
      const caja = zona.getBoundingClientRect();
      for (let i = 0; i < 14; i++) {
        window.setTimeout(() => salpicar(capa, azar(0, caja.width), azar(0, caja.height)), i * 60);
      }
    });
  });
</script>
