---
import { enlaceWhatsapp } from '../lib/whatsapp';
import { idiomaDesdeUrl, t, type Idioma } from '../i18n';

interface Props {
  pregunta: string;
  mensaje: string;
  boton?: string;
  idioma?: Idioma;
}

const idioma: Idioma = Astro.props.idioma ?? idiomaDesdeUrl(Astro.url);
const { pregunta, mensaje, boton = t(idioma).barrios.contarWhatsapp } = Astro.props;
---

<aside class="invitacion">
  <p class="invitacion__pregunta">{pregunta}</p>
  <a class="boton" href={enlaceWhatsapp(mensaje)} target="_blank" rel="noopener">{boton}</a>
</aside>

<style>
  .invitacion {
    display: grid;
    gap: 1rem;
    justify-items: start;
    padding: 1.4rem;
    background: var(--tinta);
    color: var(--blanco);
    border: 3px solid var(--tinta);
    box-shadow: 6px 6px 0 var(--fucsia);
  }

  .invitacion__pregunta {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--amarillo);
  }
</style>
