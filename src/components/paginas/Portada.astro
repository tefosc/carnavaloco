---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Chicha from '../Chicha.astro';
import Afiche from '../Afiche.astro';
import AgendaPortada from '../AgendaPortada.astro';
import Cinta from '../Cinta.astro';
import Banderolas from '../Banderolas.astro';
import CartelEdicion from '../CartelEdicion.astro';
import CartelProximo from '../CartelProximo.astro';
import Pintura from '../Pintura.astro';
import HoyEnElCarnaval from '../HoyEnElCarnaval.astro';
import Aniversarios from '../Aniversarios.astro';
import { fotos } from '../../data/fotos';
import { rutaDe, t, type Idioma } from '../../i18n';
import { conBis } from '../../lib/coplas';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const txt = t(idioma);
const p = txt.portada;

const frases = (await getCollection('frases')).map((f) => f.data);
const gritos = frases.filter((f) => f.tipo === 'grito' || f.tipo === 'dicho').map((f) => f.frase.replace(/[.]$/, ''));

const coplas = (await getCollection('coplas')).map((c) => c.data);
const pancarta = coplas.find((c) => c.id === 'lima-trujillo')!;

const ediciones = (await getCollection('ediciones')).map((e) => e.data).sort((a, b) => b.anio - a.anio);
const giros = [-3, 2, -1.5, 3.5, -2.5, 1, -3.5, 2.5, -1, 3];
---

<Base
  idioma={idioma}
  og={idioma === 'en' ? 'en-inicio' : 'inicio'}
  title={txt.sitio.nombre}
  description={p.description}
>
  <section class="portada fondo-fucsia bloque zigzag-abajo" data-pintura aria-labelledby="titulo-portada">
    <div class="capa-pintura" data-capa-pintura aria-hidden="true"></div>
    <div class="envoltura portada__grid">
      <div class="portada__texto">
        <h1 id="titulo-portada" class="portada__titulo" translate="no">
          <Chicha
            texto="Carnaval"
            class="portada__carnaval"
            relleno="var(--amarillo)"
            relleno2="var(--naranja)"
            sombra="var(--azul)"
          />
          <Chicha texto="de Cajamarca" class="portada__de" relleno="var(--blanco)" sombra="var(--tinta)" />
        </h1>
        <p class="entrada portada__entrada">{p.entrada}</p>
        <div class="portada__acciones">
          <a class="boton" href={rutaDe('2027', idioma)}>{p.verPrograma}</a>
          <a class="boton boton--hueco" href={rutaDe('barrios', idioma)}>{p.buscaBarrio}</a>
          <button class="boton boton--hueco" type="button" data-jugar>{p.echarPintura}</button>
        </div>
      </div>
      <div class="portada__visual">
        <AgendaPortada idioma={idioma} />
        <Afiche
          idioma={idioma}
          foto={fotos.patrullaCorriendo}
          giro={3}
          cinta
          carga="eager"
          sizes="(min-width: 900px) 46vw, 92vw"
          class="portada__afiche"
        />
      </div>
    </div>
    <Pintura />
  </section>

  <HoyEnElCarnaval idioma={idioma} />

  <Aniversarios idioma={idioma} />

  <section class="bloque fondo-azul oscuro dias" aria-labelledby="titulo-dias">
    <Cinta items={gritos} />
    <div class="envoltura dias__cuerpo">
      <div class="dias__cabeza">
        <h2 id="titulo-dias" class="titulo-bloque">{p.diasTitulo}</h2>
        <p class="lectura">{p.diasTexto}</p>
      </div>
      <Banderolas portada idioma={idioma} />
      <p class="dias__mas">
        <a class="boton" href={rutaDe('2027', idioma)}>{p.horarios2027}</a>
        <a class="boton boton--hueco" href={rutaDe('la-fiesta', idioma)}>{p.verPersonajes}</a>
      </p>
    </div>
  </section>

  <section class="bloque fondo-amarillo pancarta" aria-labelledby="titulo-pancarta">
    <div class="envoltura pancarta__grid">
      <h2 id="titulo-pancarta" class="visualmente-oculto">{p.unaCoplaSr}</h2>
      <div class="pancarta__marco">
        <blockquote class="pancarta__copla" lang="es">
          {
            conBis(pancarta.versos, pancarta.repite).map((v) => (
              <p>
                {v.texto}
                {v.bis && <span class="bis">bis</span>}
              </p>
            ))
          }
        </blockquote>
        {p.coplaGlosa && <p class="pancarta__glosa">{p.coplaGlosa}</p>}
      </div>
      <div class="pancarta__lado">
        <p>{p.coplaTexto}</p>
        <a class="boton boton--hueco" href={rutaDe('coplas', idioma)}>{p.masCoplas}</a>
      </div>
    </div>
  </section>

  <section class="bloque pared" aria-labelledby="titulo-pared">
    <div class="envoltura">
      <h2 id="titulo-pared" class="titulo-bloque">{p.paredTitulo}</h2>
      <p class="lectura pared__texto">{p.paredTexto}</p>
      <ul class="pared__muro">
        <li>
          <CartelProximo giro={-2} idioma={idioma} />
        </li>
        {
          ediciones.map((e, i) => (
            <li>
              <CartelEdicion edicion={e} giro={giros[(i + 1) % giros.length]} oscuro={i % 3 === 0} idioma={idioma} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bloque fondo-verde palabras zigzag-arriba" aria-labelledby="titulo-palabras">
    <div class="envoltura">
      <h2 id="titulo-palabras" class="titulo-bloque">{p.palabrasTitulo}</h2>
      <ul class="palabras__muro">
        {
          p.palabras.map((item) => (
            <li style={`--tono:${item.color}`}>
              <span class="palabras__palabra" lang="es-PE" translate="no">
                {item.palabra}
              </span>
              <span class="palabras__dice">{item.dice}</span>
            </li>
          ))
        }
      </ul>
      <a class="boton" href={rutaDe('habla', idioma)}>{p.verGlosario}</a>
    </div>
  </section>

  <section class="bloque fondo-tinta oscuro juego" aria-labelledby="titulo-juego">
    <div class="envoltura juego__grid">
      <div class="juego__texto">
        <h2 id="titulo-juego" class="titulo-bloque">{p.juegoTitulo}</h2>
        <p class="lectura">{p.juegoTexto}</p>
      </div>
      <Afiche idioma={idioma} foto={fotos.baldesDeGlobos} giro={-2} class="juego__a" sizes="(min-width: 900px) 26vw, 60vw" />
      <Afiche idioma={idioma} foto={fotos.disfracesTurquesa} giro={2.5} class="juego__b" sizes="(min-width: 900px) 22vw, 50vw" />
      <Afiche idioma={idioma} foto={fotos.globosEnLaCalle} giro={-1} class="juego__c" sizes="(min-width: 900px) 36vw, 92vw" />
      <Afiche idioma={idioma} foto={fotos.musicosDeNoche} giro={1.5} class="juego__d" sizes="(min-width: 900px) 30vw, 92vw" />
    </div>
  </section>
</Base>

<script>
  // Cuenta regresiva o, del sábado al miércoles, lo que toca hoy
  import { aplicarHoy } from '../../lib/hoy';

  aplicarHoy();
</script>

<style>
  /* ---------- Portada ---------- */
  .portada {
    padding-top: clamp(5rem, 9vw, 7rem);
    cursor: crosshair;
  }

  .portada__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .portada__titulo {
    display: grid;
    gap: 0.6rem;
    margin-bottom: 2rem;
  }

  .portada :global(.portada__carnaval) {
    font-size: clamp(5rem, 15vw, 12.5rem);
  }

  .portada :global(.portada__de) {
    font-size: clamp(2.6rem, 6.4vw, 5.2rem);
    margin-left: 0.15em;
  }

  .portada__entrada {
    font-weight: 600;
  }

  .portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .portada__visual {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .portada :global(.portada__afiche img) {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 900px) {
    .portada__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2rem;
    }

    .portada__texto,
    .portada__visual {
      display: contents;
    }

    .portada__titulo {
      order: 1;
      margin-bottom: 0;
    }

    .portada :global(.agenda-portada) {
      order: 2;
    }

    .portada__entrada {
      order: 3;
    }

    .portada__acciones {
      order: 4;
      margin-top: 0;
    }

    .portada :global(.portada__afiche) {
      order: 5;
      width: 92%;
      max-width: 520px;
      margin-inline: auto;
    }
  }

  /* ---------- Días ---------- */
  .dias {
    padding-top: calc(var(--zz) + 1.5rem);
    /* La cinta inclinada sobresale a los lados a propósito */
    overflow-x: clip;
  }

  .dias__cuerpo {
    padding-top: clamp(4rem, 8vw, 6rem);
  }

  .dias__cabeza {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: 1rem 3rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .dias__cabeza .titulo-bloque {
    margin-bottom: 0;
  }

  .dias__mas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 4rem;
  }

  @media (max-width: 800px) {
    .dias__cabeza {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Pancarta de copla ---------- */
  .pancarta__grid {
    display: grid;
    grid-template-columns: 2fr 0.65fr;
    gap: 2rem 3rem;
    align-items: end;
  }

  .pancarta__copla {
    font-family: var(--display);
    font-weight: 900;
    text-transform: uppercase;
    line-height: 1;
    /* Un verso por línea, como en una pancarta: la letra se mide contra
       el ancho de su columna, no de la ventana, así nunca se parte */
    font-size: min(5.6rem, 8cqi);
    white-space: nowrap;
  }

  .pancarta__marco {
    container-type: inline-size;
    min-width: 0;
  }

  .pancarta__glosa {
    margin-top: 1.2rem;
    font-style: italic;
    font-weight: 600;
    max-width: 56ch;
  }

  .pancarta__copla p:nth-child(1) { color: var(--tinta); }
  .pancarta__copla p:nth-child(2) { color: var(--fucsia); margin-left: 0.6em; -webkit-text-stroke: 0.025em var(--tinta); }
  .pancarta__copla p:nth-child(3) { color: var(--azul); }
  .pancarta__copla p:nth-child(4) { color: var(--tinta); margin-left: 0.3em; background: var(--blanco); justify-self: start; padding-inline: 0.15em; }

  .pancarta__copla {
    display: grid;
  }

  /* En la pancarta la letra es enorme: el bis va más chico para que el verso siga en una línea */
  .pancarta__copla .bis {
    font-size: max(0.26em, 0.65rem);
    border-width: 3px;
    vertical-align: 0.9em;
  }

  .pancarta__lado {
    display: grid;
    gap: 1.4rem;
    justify-items: start;
    font-size: 1.05rem;
  }

  @media (max-width: 860px) {
    .pancarta__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Pared de afiches ---------- */
  .pared {
    background: var(--blanco);
  }

  .pared__texto {
    margin-top: -1rem;
    margin-bottom: 3rem;
  }

  .pared__muro {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.6rem 1rem;
  }

  .pared__muro li:nth-child(4n + 2),
  .pared__muro li:nth-child(4n + 4) {
    translate: 0 1.6rem;
  }

  @media (max-width: 1000px) {
    .pared__muro {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .pared__muro li:nth-child(n) {
      translate: none;
    }
  }

  @media (max-width: 620px) {
    .pared__muro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Palabras ---------- */
  .palabras__muro {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
    gap: 2.2rem 2rem;
    margin-bottom: 3.5rem;
  }

  .palabras__muro li {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .palabras__palabra {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(3.4rem, 7vw, 6rem);
    line-height: 0.9;
    color: var(--tono);
    -webkit-text-stroke: 0.06em var(--tinta);
    paint-order: stroke fill;
  }

  .palabras__dice {
    justify-self: start;
    padding: 0.15rem 0.6rem;
    background: var(--tinta);
    color: var(--blanco);
    font-weight: 700;
    font-size: 1.2rem;
  }

  /* ---------- Juego (fotos) ---------- */
  .juego__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .juego__texto {
    grid-column: 1 / 6;
    grid-row: 1;
    align-self: center;
  }

  .juego :global(.juego__a) {
    grid-column: 6 / 9;
    grid-row: 1;
  }

  .juego :global(.juego__b) {
    grid-column: 9 / 12;
    grid-row: 1;
    margin-top: 3rem;
  }

  .juego :global(.juego__c) {
    grid-column: 2 / 7;
    grid-row: 2;
  }

  .juego :global(.juego__d) {
    grid-column: 7 / 12;
    grid-row: 2;
    margin-top: 2.5rem;
  }

  @media (max-width: 860px) {
    .juego__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .juego__texto,
    .juego :global(.juego__c),
    .juego :global(.juego__d) {
      grid-column: 1 / -1;
      grid-row: auto;
      margin-top: 0;
    }

    .juego :global(.juego__a) {
      grid-column: 1;
      grid-row: auto;
    }

    .juego :global(.juego__b) {
      grid-column: 2;
      grid-row: auto;
      margin-top: 2rem;
    }
  }
</style>
