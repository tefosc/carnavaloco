---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fuentesBarrios } from '../../data/barrios';
import { fuentes as fuentesHistoria } from '../../data/carnaval';
import { previasDe } from '../../data/carnaval2027';
import { creditoFotos, fotos } from '../../data/fotos';
import { fuentesGuia } from '../../data/guia';
import { fechaFuente, t, type Idioma } from '../../i18n';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const p = t(idioma).fuentes;
const licenciaUrl = idioma === 'en' ? creditoFotos.licenciaUrl.replace('/deed.es', '/deed.en') : creditoFotos.licenciaUrl;

interface Fuente {
  medio: string;
  titulo?: string;
  url: string;
  nota?: string;
  /** `es` si el título y el medio están en español (en /en/ se marcan con lang). */
  lang?: string;
}

const enEspanol = <T extends object>(fuentes: T[]) => fuentes.map((fuente) => ({ ...fuente, lang: 'es' }));

const coplas = await getCollection('coplas');
const ediciones = await getCollection('ediciones');
const referenciasCoplas = new Map<string, Fuente>();
for (const { data: copla } of coplas) {
  if (!copla.fuente) continue;
  const anterior = referenciasCoplas.get(copla.fuente.url);
  const verso = copla.versos[0].replace(/[,.;]$/, '');
  referenciasCoplas.set(copla.fuente.url, {
    ...copla.fuente,
    nota: [anterior?.nota, '«' + verso + '»'].filter(Boolean).join(' · '),
  });
}

const programa: Fuente[] = [
  {
    titulo: 'Programa oficial del Carnaval 2026',
    medio: 'Municipalidad Provincial de Cajamarca',
    url: 'https://www.gob.pe/institucion/municajamarca/noticias/1334566-programa-oficial-del-carnaval-2026',
    nota: p.programaNota2026,
    lang: 'es',
  },
  ...previasDe(idioma).flatMap((previa) => previa.fuente ? [{
    titulo: previa.titulo,
    medio: p.anuncioOficial,
    url: previa.fuente,
  }] : []),
  { titulo: 'OpenStreetMap', medio: p.osmMedio, url: 'https://www.openstreetmap.org/copyright', nota: p.osmNota },
  { titulo: 'OpenFreeMap', medio: 'OpenFreeMap', url: 'https://openfreemap.org', nota: p.openFreeMapNota },
  { titulo: 'OpenMapTiles', medio: 'OpenMapTiles', url: 'https://www.openmaptiles.org/', nota: p.openMapTilesNota },
  { titulo: 'Mapterhorn', medio: 'Mapterhorn', url: 'https://mapterhorn.com/attribution', nota: p.mapterhornNota },
];

const secciones = [
  { id: 'programa', ...p.secciones.programa, fuentes: programa },
  { id: 'barrios', ...p.secciones.barrios, fuentes: enEspanol(fuentesBarrios) },
  { id: 'historia', ...p.secciones.historia, fuentes: enEspanol(fuentesHistoria) },
  {
    id: 'ediciones',
    ...p.secciones.ediciones,
    grupos: ediciones.map(({ data }) => data).sort((a, b) => b.anio - a.anio).map((edicion) => ({
      id: 'edicion-' + edicion.anio, titulo: String(edicion.anio), fuentes: enEspanol(edicion.fuentes),
    })),
  },
  {
    id: 'guia',
    ...p.secciones.guia,
    fuentes: fuentesGuia.map((f) => ({ medio: f.medio, titulo: f.titulo, url: f.url, nota: f.fecha && fechaFuente(f.fecha, idioma), lang: 'es' })),
  },
  { id: 'coplas', ...p.secciones.coplas, fuentes: enEspanol([...referenciasCoplas.values()]) },
  {
    id: 'creditos',
    ...p.secciones.creditos,
    fuentes: Object.values(fotos).map((foto) => ({
      titulo: idioma === 'en' ? foto.altEn : foto.alt,
      medio: creditoFotos.autor,
      url: creditoFotos.enlace(foto.archivo),
    })),
  },
];

const referencias = new Map<string, string>();
function prepararFuentes(fuentes: Fuente[]) {
  const unicas = new Map(fuentes.map((fuente) => [fuente.url, fuente]));
  return [...unicas.values()].map((fuente) => {
    const referencia = referencias.get(fuente.url);
    const id = referencia ?? 'referencia-' + (referencias.size + 1);
    referencias.set(fuente.url, id);
    return { ...fuente, id: referencia ? undefined : id, enlace: referencia ? '#' + referencia : fuente.url };
  });
}

const archivo = secciones.map((seccion) => ({
  ...seccion,
  lista: seccion.fuentes ? prepararFuentes(seccion.fuentes) : [],
  grupos: seccion.grupos?.map((grupo) => ({ ...grupo, lista: prepararFuentes(grupo.fuentes) })),
}));
---

<Base idioma={idioma} og={idioma === 'en' ? 'en-fuentes' : 'fuentes'} title={p.title} description={p.description}>
  <header class="encabezado" data-sin-manchas>
    <div class="envoltura">
      <h1>{p.title}</h1>
      <p>{p.intro}</p>
    </div>
  </header>

  <div class="envoltura archivo">
    <nav aria-label={p.indiceAria} class="indice">
      <ul>
        {archivo.map((seccion) => <li><a href={'#' + seccion.id}>{seccion.titulo}</a></li>)}
      </ul>
    </nav>
    <div class="apartados">
      {archivo.map((seccion) => (
        <section id={seccion.id} aria-labelledby={'titulo-' + seccion.id} data-sin-manchas>
          <h2 id={'titulo-' + seccion.id}>{seccion.titulo}</h2>
          <p class="descripcion">{seccion.descripcion}</p>
          {seccion.id === 'creditos' && (
            <p class="licencia">{p.licenciaAntes}<a href={licenciaUrl}>{p.licenciaTexto} {creditoFotos.licencia}</a>.</p>
          )}
          {seccion.lista.length > 0 && (
            <ul class="referencias">
              {seccion.lista.map((fuente) => (
                <li id={fuente.id}>
                  <a href={fuente.enlace} lang={fuente.lang}>{fuente.titulo ?? fuente.medio}</a>
                  {fuente.titulo && <span lang={fuente.lang}>{fuente.medio}</span>}
                  {fuente.nota && <p lang={seccion.id === 'coplas' ? 'es' : undefined}>{fuente.nota}</p>}
                </li>
              ))}
            </ul>
          )}
          {seccion.grupos?.map((grupo) => (
            <details id={grupo.id}>
              <summary>{grupo.titulo}</summary>
              <ul class="referencias">
                {grupo.lista.map((fuente) => (
                  <li id={fuente.id}>
                    <a href={fuente.enlace} lang={fuente.lang}>{fuente.titulo ?? fuente.medio}</a>
                    {fuente.titulo && <span lang={fuente.lang}>{fuente.medio}</span>}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  function abrirReferencia() {
    const destino = document.getElementById(location.hash.slice(1));
    const grupo = destino?.closest('details');
    if (!grupo || grupo.open) return;
    grupo.open = true;
    destino?.scrollIntoView();
  }

  abrirReferencia();
  addEventListener('hashchange', abrirReferencia);
</script>

<style>
  .encabezado {
    padding-block: clamp(3rem, 7vw, 6.5rem);
    background: var(--tinta);
    color: var(--blanco);
    border-bottom: 8px solid var(--amarillo);
  }

  h1 {
    font-size: clamp(3.5rem, 9vw, 7rem);
    color: var(--amarillo);
    text-transform: uppercase;
    line-height: 0.94;
    text-wrap: balance;
  }

  .encabezado p {
    max-width: 52ch;
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .archivo {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 8vw, 7rem);
  }

  .indice {
    align-self: start;
    position: sticky;
    top: 1.25rem;
  }

  .indice ul,
  .referencias {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .indice a {
    display: block;
    padding: 0.62rem 0;
    font-weight: 750;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .apartados { min-width: 0; }
  section + section { margin-top: clamp(2.8rem, 5vw, 4.25rem); }

  h2 {
    font-size: clamp(2.1rem, 4.1vw, 3.7rem);
    text-transform: uppercase;
    line-height: 1;
  }

  .descripcion { margin-block: 0.6rem 1.1rem; }
  .licencia { margin-block: 0 1rem; }

  .referencias li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--tinta) 20%, transparent);
    overflow-wrap: anywhere;
  }

  .referencias a {
    justify-self: start;
    font-weight: 750;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .referencias span,
  .referencias p {
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--tinta) 86%, var(--blanco));
  }

  .referencias li:target { background: color-mix(in srgb, var(--amarillo) 25%, var(--blanco)); }

  details {
    border-top: 1px solid color-mix(in srgb, var(--tinta) 24%, transparent);
  }

  summary {
    padding: 0.6rem 0.35rem;
    cursor: pointer;
    font-family: var(--display);
    font-size: 1.55rem;
    font-weight: 900;
  }

  summary::marker { color: var(--azul); }
  summary:hover,
  summary:focus-visible { background: color-mix(in srgb, var(--amarillo) 25%, var(--blanco)); }
  details .referencias { padding-inline: 1rem; }

  @media (max-width: 740px) {
    .archivo { grid-template-columns: minmax(0, 1fr); }
    .indice { position: static; }
    .indice ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
      padding-block: 0.35rem;
      border-block: 1px solid color-mix(in srgb, var(--tinta) 24%, transparent);
    }
  }
</style>
