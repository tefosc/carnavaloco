---
import Base from '../../layouts/Base.astro';
import CabezaPagina from '../CabezaPagina.astro';
import { seccionesDe, revisadoEn, revisadoEnEn } from '../../data/guia';
import { rutaDe, t, type Idioma } from '../../i18n';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const p = t(idioma).guia;
const secciones = seccionesDe(idioma);
const fechaRevision = idioma === 'en' ? revisadoEnEn : revisadoEn;
---

<Base
  idioma={idioma}
  og={idioma === 'en' ? 'en-guia' : 'guia'}
  title={p.title}
  description={p.description}
>
  <CabezaPagina titulo={p.cabezaTitulo} fondo="var(--azul)" tintaTexto="var(--blanco)" relleno="var(--amarillo)" sombra="var(--fucsia)">
    <p>{p.intro}</p>
    <p class="guia__revision">{p.revision(fechaRevision)}</p>
  </CabezaPagina>

  <nav class="guia__indice bloque" aria-label={p.indiceAria}>
    <div class="envoltura">
      <ul>
        {
          secciones.map((s) => (
            <li>
              <a href={`#${s.id}`} data-color={s.color}>
                {s.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    secciones.map((s) => (
      <section
        id={s.id}
        class:list={['bloque guia__seccion', `fondo-${s.color}`, { oscuro: s.color === 'azul' }]}
        aria-labelledby={`titulo-${s.id}`}
      >
        <div class="envoltura">
          <h2 id={`titulo-${s.id}`} class="titulo-bloque">
            {s.titulo}
          </h2>
          <p class="lectura guia__intro">{s.intro}</p>
          <ul class="guia__datos">
            {s.datos.map((d) => (
              <li class="guia__dato claro">
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
                {d.verificar && (
                  <p class="guia__verificar">
                    <strong>{p.verificalo}</strong> {p.verificaloTexto}
                  </p>
                )}
                {d.fuente && (
                  <p class="guia__fuente">
                    {p.fuente}{' '}
                    <a href={d.fuente.url} rel="noopener" lang="es">
                      {d.fuente.medio}: {d.fuente.titulo}
                    </a>
                    {d.fuente.fecha && <span lang="es"> ({d.fuente.fecha})</span>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="bloque guia__cierre" aria-labelledby="titulo-cierre">
    <div class="envoltura">
      <h2 id="titulo-cierre" class="titulo-bloque">{p.cierreTitulo}</h2>
      <p class="lectura">{p.cierreTexto}</p>
      <p class="guia__enlaces">
        <a class="boton" href={rutaDe('2027', idioma)}>{p.programa2027}</a>
        <a class="boton boton--hueco" href={rutaDe('fuentes', idioma)}>{p.fuentesYCreditos}</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .guia__revision {
    margin-top: 0.9rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .guia__indice {
    padding-block: 1.6rem 0;
  }

  .guia__indice ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
  }

  .guia__indice a {
    display: block;
    min-height: 44px;
    padding: 0.45rem 0.9rem 0.35rem;
    border: 3px solid var(--tinta);
    border-bottom: 10px solid var(--c);
    background: var(--blanco);
    color: var(--tinta);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .guia__indice a:hover {
    background: var(--c);
  }

  .guia__intro {
    margin-bottom: 2.2rem;
    font-weight: 600;
  }

  .guia__datos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    padding: 0;
  }

  .guia__dato {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.3rem 1.4rem 1.4rem;
    background: var(--blanco);
    color: var(--tinta);
    border: 4px solid var(--tinta);
    box-shadow: 6px 6px 0 var(--tinta);
  }

  .guia__dato h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .guia__verificar {
    padding: 0.5rem 0.7rem;
    background: repeating-linear-gradient(-45deg, var(--amarillo) 0 10px, var(--blanco) 10px 20px);
    border: 2px solid var(--tinta);
    font-size: 0.92rem;
  }

  .guia__fuente {
    font-size: 0.88rem;
    overflow-wrap: anywhere;
  }

  .guia__fuente a {
    color: inherit;
  }

  .guia__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  @media (max-width: 860px) {
    .guia__datos {
      grid-template-columns: 1fr;
    }
  }
</style>
