---
import Base from '../../layouts/Base.astro';
import CabezaPagina from '../CabezaPagina.astro';
import Banderolas from '../Banderolas.astro';
import Sello from '../Sello.astro';
import Mascara from '../Mascara.astro';
import Afiche from '../Afiche.astro';
import Pintura from '../Pintura.astro';
import { personajesDe, costumbresDe, musicaDe, saboresDe } from '../../data/carnaval';
import { fotos } from '../../data/fotos';
import { rutaDe, t, type Idioma } from '../../i18n';
import { anioProximoCarnaval, momentoDelCarnaval } from '../../lib/fechas';

interface Props {
  idioma?: Idioma;
}

const { idioma = 'es' } = Astro.props;
const p = t(idioma).laFiesta;
const anio = anioProximoCarnaval();
const momento = momentoDelCarnaval(anio);
const faltan = momento.fase === 'antes' ? momento.faltan : 0;
const coloresOrquesta = ['var(--amarillo)', 'var(--fucsia)', 'var(--turquesa)', 'var(--naranja)', 'var(--verde)', 'var(--blanco)'];

const personajes = personajesDe(idioma);
const costumbres = costumbresDe(idioma);
const musica = musicaDe(idioma);
const sabores = saboresDe(idioma);
---

<Base
  idioma={idioma}
  og={idioma === 'en' ? 'en-la-fiesta' : 'la-fiesta'}
  title={p.title}
  description={p.description}
>
  <CabezaPagina
    titulo={p.title}
    fondo="var(--azul)"
    tintaTexto="var(--blanco)"
    relleno="var(--amarillo)"
    relleno2="var(--naranja)"
    sombra="var(--fucsia)"
    pintura
  >
    <p>{p.intro}</p>
    <Sello slot="lado" anillo="Carnaval de Cajamarca ✶ Carnaval de Cajamarca ✶ " color="var(--amarillo)" giro={8}>
      <span class="cuenta__numero" data-cuenta-dias data-anio="proximo">{faltan}</span>
      <span class="cuenta__texto" data-cuenta-texto data-uno={p.diaUnoParaEmpezar} data-varios={p.diasParaEmpezar}>
        {faltan === 1 ? p.diaUnoParaEmpezar : p.diasParaEmpezar}
      </span>
    </Sello>
  </CabezaPagina>
  <Pintura />

  <section class="bloque fondo-tinta oscuro" aria-labelledby="titulo-programa">
    <div class="envoltura">
      <h2 id="titulo-programa" class="titulo-bloque">{p.programaDe(anio)}</h2>
      <Banderolas idioma={idioma} />
      <p class="lectura nota-fechas">{p.notaFechas}</p>
      <p class="ir-2027"><a class="boton" href={rutaDe('2027', idioma)}>{p.verPrograma2027}</a></p>
    </div>
  </section>

  <section class="bloque personajes" aria-labelledby="titulo-personajes">
    <div class="envoltura personajes__grid">
      <div class="personajes__visual">
        <Mascara class="personajes__mascara" />
        <Afiche idioma={idioma} foto={fotos.disfrazPicaflor} giro={-3} class="personajes__foto-a" sizes="(min-width: 900px) 18vw, 45vw" />
        <Afiche idioma={idioma} foto={fotos.disfrazAbanico} giro={2.5} class="personajes__foto-b" sizes="(min-width: 900px) 16vw, 40vw" />
      </div>
      <div>
        <h2 id="titulo-personajes" class="titulo-bloque">{p.quienEsQuien}</h2>
        <dl class="personajes__lista">
          {
            personajes.map((item) => (
              <div data-color={item.color}>
                <dt>{item.nombre}</dt>
                <dd>{item.texto}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </section>

  <section class="bloque fondo-turquesa costumbres zigzag-arriba" aria-labelledby="titulo-costumbres">
    <div class="envoltura">
      <h2 id="titulo-costumbres" class="titulo-bloque">{p.costumbres}</h2>
      <ul class="costumbres__lista">
        {
          costumbres.map((c) => (
            <li>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bloque fondo-tinta oscuro orquesta" aria-labelledby="titulo-orquesta">
    <div class="envoltura orquesta__grid">
      <div>
        <h2 id="titulo-orquesta" class="titulo-bloque">{p.musicaTitulo}</h2>
        <p class="lectura">{p.musicaTexto}</p>
        <h3 class="orquesta__danzas-titulo">{p.danzasTitulo}</h3>
        <ul class="orquesta__danzas">
          {musica.danzas.map((d) => <li translate="no">{d}</li>)}
        </ul>
      </div>
      <ul class="orquesta__cartel" aria-label={p.instrumentosAria}>
        {
          musica.instrumentos.map((ins, i) => (
            <li style={`--tono:${coloresOrquesta[i % coloresOrquesta.length]}`}>{p.instrumentoFormato(ins)}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="bloque fondo-amarillo pizarra" aria-labelledby="titulo-pizarra">
    <div class="envoltura pizarra__grid">
      <h2 id="titulo-pizarra" class="titulo-bloque">{p.hoyHay}</h2>
      <dl class="pizarra__menu">
        {
          sabores.map((s) => (
            <div>
              <dt>{s.nombre}</dt>
              <dd>{s.texto}</dd>
            </div>
          ))
        }
      </dl>
      <Afiche idioma={idioma} foto={fotos.patioMunicipal} giro={2} class="pizarra__foto" sizes="(min-width: 900px) 30vw, 90vw" />
    </div>
  </section>
  <p class="envoltura enlace-fuentes"><a href={`${rutaDe('fuentes', idioma)}#historia`}>{p.fuentesTradiciones}</a></p>
</Base>

<script>
  import { aplicarHoy } from '../../lib/hoy';

  aplicarHoy();
</script>

<style>
  .cuenta__numero {
    font-size: clamp(2.6rem, 4.6vw, 3.6rem);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .cuenta__texto {
    font-size: 0.95rem;
  }

  .nota-fechas {
    margin-top: 4rem;
    font-size: 1rem;
    opacity: 0.85;
  }

  .ir-2027 {
    margin-top: 1.5rem;
  }

  /* ---------- Personajes ---------- */
  .personajes__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3rem 5rem;
    align-items: start;
  }

  .personajes__visual {
    position: sticky;
    top: 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .personajes :global(.personajes__mascara) {
    grid-column: 1 / -1;
    width: min(100%, 360px);
    justify-self: center;
  }

  .personajes :global(.personajes__foto-b) {
    margin-top: 2.5rem;
  }

  .personajes__lista {
    display: grid;
    gap: 1.8rem;
  }

  .personajes__lista dt {
    display: inline-block;
    padding: 0.25rem 0.6rem 0.15rem;
    background: var(--c);
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .personajes__lista [data-color='azul'] dt {
    color: var(--blanco);
  }

  .personajes__lista dd {
    margin: 0.5rem 0 0;
    max-width: 52ch;
  }

  /* ---------- Costumbres ---------- */
  .costumbres__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2.5rem;
  }

  .costumbres__lista li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 6px solid var(--tinta);
  }

  .costumbres__lista h3 {
    font-size: clamp(1.9rem, 3vw, 2.5rem);
    text-transform: uppercase;
  }

  /* ---------- Orquesta (cartel chicha) ---------- */
  .orquesta__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
    align-items: start;
  }

  .orquesta__danzas-titulo {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 2rem;
    text-transform: uppercase;
    color: var(--amarillo);
  }

  .orquesta__danzas {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.4rem;
    font-weight: 700;
    font-size: 1.2rem;
  }

  .orquesta__cartel {
    list-style: none;
    display: grid;
    justify-items: center;
    text-align: center;
    padding: 1.6rem 1rem;
    border: 4px solid var(--amarillo);
    rotate: 1.5deg;
  }

  .orquesta__cartel li {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 0.95;
    text-transform: uppercase;
    color: var(--tono);
  }

  .orquesta__cartel li:nth-child(3n + 2) {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
  }

  /* ---------- Pizarra ---------- */
  .pizarra__grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem 4rem;
    align-items: start;
  }

  .pizarra__grid .titulo-bloque {
    grid-column: 1 / -1;
  }

  .pizarra__menu {
    display: grid;
    gap: 1.4rem;
  }

  .pizarra__menu dt {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.8rem, 3.2vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .pizarra__menu dt::after {
    content: '';
    flex: 1;
    border-bottom: 4px dotted var(--tinta);
  }

  .pizarra__menu dd {
    margin: 0.35rem 0 0;
    font-weight: 500;
  }

  @media (max-width: 900px) {
    .personajes__grid,
    .orquesta__grid,
    .pizarra__grid {
      grid-template-columns: 1fr;
    }

    .personajes__visual {
      position: static;
    }

    .costumbres__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .costumbres__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
