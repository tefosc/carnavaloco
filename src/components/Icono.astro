---
import { iconos, type NombreIcono } from '../data/iconos';

interface Props {
  nombre: NombreIcono;
}

const { nombre } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={iconos[nombre]}
>
</svg>
