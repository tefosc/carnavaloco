---
/**
 * Aviso de que la web funciona sin señal, con un botón para instalarla en el teléfono.
 * El botón solo aparece si el navegador puede instalarla (navigator.install o
 * beforeinstallprompt); si no, queda el aviso solo.
 */
---

<div class="llevalo claro">
  <h3>Sin señal, igual funciona</h3>
  <p>
    Abre esta web una vez con internet y queda guardada en tu teléfono: el programa, el mapa plano, las coplas y el
    glosario se abren aunque en el corso no haya señal. El mapa 3D sí necesita internet.
  </p>
  <button type="button" class="boton" data-instalar hidden>Instalar en el teléfono</button>
  <p class="llevalo__estado" role="status" data-instalar-estado></p>
</div>

<style>
  .llevalo {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    margin-top: 3rem;
    padding: 1.4rem 1.6rem 1.6rem;
    max-width: 46rem;
    background: var(--blanco);
    color: var(--tinta);
    border: 4px solid var(--tinta);
    box-shadow: 8px 8px 0 var(--tinta);
  }

  .llevalo h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    text-transform: uppercase;
  }

  .llevalo__estado {
    font-weight: 700;
  }

  .llevalo__estado:empty {
    display: none;
  }
</style>

<script>
  interface AvisoInstalacion extends Event {
    prompt: () => Promise<void>;
    userChoice: Promise<{ outcome: 'accepted' | 'dismissed' }>;
  }

  const boton = document.querySelector<HTMLButtonElement>('[data-instalar]');
  const estado = document.querySelector<HTMLElement>('[data-instalar-estado]');
  // navigator.install() es la API nueva; beforeinstallprompt, la de Chrome y Edge
  const instalarNuevo = (navigator as Navigator & { install?: () => Promise<void> }).install;
  let aviso: AvisoInstalacion | undefined;

  if (boton && estado) {
    if (typeof instalarNuevo === 'function') boton.hidden = false;

    addEventListener('beforeinstallprompt', (evento) => {
      evento.preventDefault();
      aviso = evento as AvisoInstalacion;
      boton.hidden = false;
    });

    addEventListener('appinstalled', () => {
      boton.hidden = true;
      estado.textContent = 'Listo: ya está en tu teléfono.';
    });

    boton.addEventListener('click', async () => {
      if (boton.getAttribute('aria-disabled') === 'true') return;
      // aria-disabled y no disabled: así el foco no se pierde
      boton.setAttribute('aria-disabled', 'true');
      try {
        if (typeof instalarNuevo === 'function') {
          // Se llama dentro del clic: si se demora, el navegador ya no lo permite
          await instalarNuevo.call(navigator);
          estado.textContent = 'Listo: ya está en tu teléfono.';
          boton.hidden = true;
        } else if (aviso) {
          // El aviso sirve una sola vez
          const esteAviso = aviso;
          aviso = undefined;
          await esteAviso.prompt();
          const { outcome } = await esteAviso.userChoice;
          estado.textContent = outcome === 'accepted' ? 'Listo: ya está en tu teléfono.' : 'No se instaló.';
          if (!aviso) boton.hidden = true;
        }
      } catch (error) {
        estado.textContent =
          error instanceof DOMException && error.name === 'AbortError'
            ? 'No se instaló.'
            : 'No se pudo instalar desde aquí.';
        if (!(error instanceof DOMException && error.name === 'AbortError')) console.error(error);
      } finally {
        boton.removeAttribute('aria-disabled');
      }
    });
  }
</script>
