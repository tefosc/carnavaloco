---
/**
 * Aviso de que la web funciona sin señal, con un botón para instalarla en el teléfono.
 * El botón solo aparece si el navegador puede instalarla (navigator.install o
 * beforeinstallprompt); si no, queda el aviso solo.
 */
---

<div class="llevalo claro">
  <h3>Sin señal, igual funciona</h3>
  <p>
    El programa, el calendario, los barrios, las coplas y los recorridos se guardan automáticamente con la primera
    visita con internet. Puedes usarlos sin señal cuando termine la descarga.
  </p>
  <p class="llevalo__estado" role="status" data-guardado></p>
  <button type="button" class="boton" data-instalar hidden>Instalar en el teléfono</button>
  <p class="llevalo__estado" role="status" data-instalar-estado></p>
</div>

<style>
  .llevalo {
    display: grid;
    gap: 0.8rem;
    justify-items: start;
    margin-top: 3rem;
    padding: 1.4rem 1.6rem 1.6rem;
    max-width: 46rem;
    background: var(--blanco);
    color: var(--tinta);
    border: 4px solid var(--tinta);
    box-shadow: 8px 8px 0 var(--tinta);
  }

  .llevalo h3 {
    font-size: clamp(1.8rem, 3vw, 2.4rem);
    text-transform: uppercase;
  }

  .llevalo__estado {
    font-weight: 700;
  }

  .llevalo__estado:empty {
    display: none;
  }
</style>

<script>
  import { alCambiar, disponible, instalar, yaInstalada } from '../lib/instalar';

  const boton = document.querySelector<HTMLButtonElement>('[data-instalar]');
  const estado = document.querySelector<HTMLElement>('[data-instalar-estado]');

  if (boton && estado) {
    alCambiar(() => {
      boton.hidden = !disponible();
      if (yaInstalada()) estado.textContent = 'Listo: ya está en tu teléfono.';
    });

    boton.addEventListener('click', async () => {
      // aria-disabled y no disabled: así el foco no se pierde
      if (boton.getAttribute('aria-disabled') === 'true') return;
      boton.setAttribute('aria-disabled', 'true');
      const resultado = await instalar();
      estado.textContent =
        resultado === 'instalada'
          ? 'Listo: ya está en tu teléfono.'
          : resultado === 'cancelada'
            ? 'No se instaló.'
            : 'No se pudo instalar desde aquí.';
      boton.removeAttribute('aria-disabled');
    });
  }
</script>
