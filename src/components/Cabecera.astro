---
const enlaces = [
  { href: '/2027/', texto: '2027', especial: true },
  { href: '/la-fiesta/', texto: 'La fiesta' },
  { href: '/ediciones/', texto: 'Ediciones' },
  { href: '/barrios/', texto: 'Barrios' },
  { href: '/coplas/', texto: 'Coplas' },
  { href: '/habla/', texto: 'Habla' },
  { href: '/historia/', texto: 'Historia' },
];

const ruta = Astro.url.pathname.replace(/\/?$/, '/');
const actual = (href: string) => ruta === href || (href !== '/' && ruta.startsWith(href));

// Banderines de raso colgando de una cuerda.
const colores = ['var(--fucsia)', 'var(--amarillo)', 'var(--verde)', 'var(--azul)', 'var(--naranja)', 'var(--turquesa)'];
const n = 30;
const banderines = Array.from({ length: n }, (_, i) => {
  const t = (i + 0.5) / n;
  const x = t * 1200;
  const y = 2 + 4 * 14 * t * (1 - t);
  return { d: `M${(x - 19).toFixed(1)} ${(y - 1).toFixed(1)} L${(x + 19).toFixed(1)} ${(y + 1).toFixed(1)} L${x.toFixed(1)} ${(y + 30).toFixed(1)} Z`, color: colores[i % colores.length] };
});
---

<a class="saltar" href="#contenido">Ir al contenido</a>
<header class="cabecera oscuro">
  <div class="envoltura cabecera__fila">
    <a class="marca" href="/" aria-label="Carnaval de Cajamarca, portada">
      <span class="marca__grande">Carnaval</span>
      <span class="marca__chica">de Cajamarca</span>
    </a>
    <!-- Solo en el teléfono y con JavaScript: lo muestra el script de abajo -->
    <button type="button" class="menu-boton" aria-expanded="false" aria-controls="menu-principal" data-menu-boton hidden>
      <span class="menu-boton__rayas" aria-hidden="true"></span>
      <span>Menú</span>
    </button>
    <nav id="menu-principal" aria-label="Secciones" data-menu>
      <ul>
        {
          enlaces.map((e) => (
            <li>
              <a
                href={e.href}
                aria-current={actual(e.href) ? 'page' : undefined}
                class:list={{ 'nav__especial': e.especial }}
              >
                {e.texto}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>
<svg class="banderines" viewBox="0 0 1200 46" preserveAspectRatio="none" aria-hidden="true">
  <path d="M0 2 Q600 30 1200 2" fill="none" stroke="var(--tinta)" stroke-width="2"></path>
  {banderines.map((b) => <path d={b.d} fill={b.color} />)}
</svg>

<style>
  .saltar {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.7rem 1rem;
    background: var(--amarillo);
    color: var(--tinta);
    font-weight: 700;
  }

  .saltar:focus-visible {
    top: 1rem;
  }

  .cabecera {
    position: relative;
    z-index: 20;
    background: var(--tinta);
    view-transition-name: cabecera;
  }

  .cabecera__fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    min-height: 4.5rem;
    padding-block: 0.6rem;
  }

  .marca {
    display: grid;
    text-decoration: none;
    line-height: 0.85;
  }

  .marca__grande {
    font-family: var(--display);
    font-weight: 900;
    font-size: 2.1rem;
    text-transform: uppercase;
    color: var(--amarillo);
  }

  .marca__chica {
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--fucsia);
    padding-left: 0.1rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.4rem;
  }

  nav a {
    display: block;
    padding: 0.55rem 0.8rem 0.45rem;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.35rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    text-decoration: none;
    white-space: nowrap;
    color: var(--blanco);
    transition:
      background-color 0.15s ease,
      color 0.15s ease;
  }

  nav a:hover {
    background: var(--fucsia);
  }

  nav a[aria-current='page'] {
    background: var(--amarillo);
    color: var(--tinta);
  }

  /* El próximo carnaval va siempre resaltado, como un sticker */
  nav a.nav__especial {
    background: var(--fucsia);
    color: var(--tinta);
    rotate: -3deg;
  }

  nav a.nav__especial[aria-current='page'],
  nav a.nav__especial:hover {
    background: var(--amarillo);
  }

  .banderines {
    position: relative;
    z-index: 19;
    width: 100%;
    height: 46px;
    margin-bottom: -46px;
    pointer-events: none;
    view-transition-name: banderines;
  }

  .menu-boton {
    display: none;
  }

  @media (max-width: 760px) {
    /* Fija arriba: el botón «Menú» queda a mano sin volver al inicio.
       Si el menú abierto no cabe en pantallas bajas, se desplaza por dentro. */
    .cabecera {
      position: sticky;
      top: 0;
      z-index: 45;
      max-height: 100dvh;
      overflow-y: auto;
      overscroll-behavior: contain;
    }

    .cabecera__fila {
      flex-direction: column;
      align-items: flex-start;
    }

    nav {
      width: 100%;
    }

    nav ul {
      gap: 0.2rem 0.15rem;
    }

    nav a {
      font-size: 1.2rem;
      padding-inline: 0.65rem;
    }

    /* Con JavaScript: marca a la izquierda, botón «Menú» a la derecha y los enlaces
       en una lista que baja a todo el ancho. Sin JavaScript queda lo de arriba. */
    .cabecera__fila.con-menu {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
    }

    .cabecera__fila.con-menu nav {
      flex-basis: 100%;
      order: 3;
    }

    .cabecera__fila.con-menu nav:not(.abierto) {
      display: none;
    }

    .cabecera__fila.con-menu nav ul {
      flex-direction: column;
      gap: 0.15rem;
      padding-bottom: 0.8rem;
    }

    .cabecera__fila.con-menu nav a {
      font-size: 1.7rem;
      padding: 0.7rem 0.9rem 0.6rem;
      border-top: 2px solid rgb(255 255 255 / 0.14);
    }

    .cabecera__fila.con-menu nav a.nav__especial {
      justify-self: start;
      width: fit-content;
      margin-block: 0.4rem;
    }

    .menu-boton:not([hidden]) {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 48px;
      padding: 0.3rem 0.9rem 0.2rem;
      border: 3px solid var(--amarillo);
      background: transparent;
      color: var(--amarillo);
      font-family: var(--display);
      font-weight: 800;
      font-size: 1.4rem;
      text-transform: uppercase;
      letter-spacing: 0.02em;
      cursor: pointer;
    }

    .menu-boton[aria-expanded='true'] {
      background: var(--amarillo);
      color: var(--tinta);
    }

    /* Las tres rayas se vuelven una X al abrir */
    .menu-boton__rayas,
    .menu-boton__rayas::before,
    .menu-boton__rayas::after {
      display: block;
      width: 1.4rem;
      height: 3px;
      background: currentColor;
      content: '';
    }

    .menu-boton__rayas {
      position: relative;
    }

    .menu-boton__rayas::before,
    .menu-boton__rayas::after {
      position: absolute;
      left: 0;
    }

    .menu-boton__rayas::before {
      top: -7px;
    }

    .menu-boton__rayas::after {
      top: 7px;
    }

    .menu-boton[aria-expanded='true'] .menu-boton__rayas {
      background: transparent;
    }

    .menu-boton[aria-expanded='true'] .menu-boton__rayas::before {
      top: 0;
      rotate: 45deg;
    }

    .menu-boton[aria-expanded='true'] .menu-boton__rayas::after {
      top: 0;
      rotate: -45deg;
    }
  }

  @media (max-width: 380px) {
    nav a {
      font-size: 1.05rem;
      padding-inline: 0.45rem;
    }

    .cabecera__fila.con-menu nav a {
      font-size: 1.5rem;
    }
  }
</style>

<script>
  // Menú del teléfono: los enlaces se esconden detrás del botón «Menú».
  // Sin JavaScript, o en pantallas anchas, los enlaces quedan a la vista.
  const fila = document.querySelector<HTMLElement>('.cabecera__fila');
  const boton = document.querySelector<HTMLButtonElement>('[data-menu-boton]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  if (fila && boton && menu) {
    boton.hidden = false;
    fila.classList.add('con-menu');

    const abrir = (abierto: boolean) => {
      menu.classList.toggle('abierto', abierto);
      boton.setAttribute('aria-expanded', String(abierto));
    };

    boton.addEventListener('click', () => abrir(boton.getAttribute('aria-expanded') !== 'true'));

    // Escape lo cierra y devuelve el foco al botón
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && boton.getAttribute('aria-expanded') === 'true') {
        abrir(false);
        boton.focus();
      }
    });

    // Al volver con «atrás», el menú no debe quedar abierto
    addEventListener('pageshow', () => abrir(false));
  }
</script>
