---
import { Image } from 'astro:assets';
import { ANIO, dias } from '../data/carnaval2027';
import { fotos, type Foto } from '../data/fotos';
import { diaDeCarnaval, formatearFecha, momentoDelCarnaval } from '../lib/fechas';

const afiches: Record<string, { frase: string; foto?: Foto }> = {
  sabado: { frase: 'Sale el Ño y la calle se llena de pintura.', foto: fotos.globosEnLaCalle },
  domingo: { frase: 'Cada barrio sale con su patrulla, sus coplas y su comparsa.', foto: fotos.musicosDeNoche },
  lunes: { frase: 'Carros alegóricos, reinas y comparsas toman la ciudad.', foto: fotos.disfrazAbanico },
  martes: { frase: 'Las viudas lloran al Ño entre bromas y actuaciones.' },
  miercoles: { frase: 'Se lee el testamento y el Ño se despide entre llamas.' },
};

const formatoDia = new Intl.DateTimeFormat('es-PE', { weekday: 'long', timeZone: 'UTC' });
const momento = momentoDelCarnaval(ANIO);
---

<ol class="pasacalle" data-pasacalle>
  {dias.map((dia) => {
    const afiche = afiches[dia.id];
    const fecha = diaDeCarnaval(ANIO, dia.offset);
    const hoy = momento.fase === 'durante' && momento.offset === dia.offset;
    return (
      <li class:list={['parada', 'parada--' + dia.id]} data-color={dia.color} data-parada={dia.offset} aria-current={hoy ? 'date' : undefined}>
        <div class="parada__texto">
          <div class="parada__fecha">
            <time datetime={fecha.toISOString().slice(0, 10)}>
              <strong>{formatoDia.format(fecha)}</strong>
              <span>{formatearFecha(fecha)}</span>
            </time>
            <span class="parada__hoy" hidden={!hoy}>Hoy</span>
          </div>
          <h3>{dia.titulo}</h3>
          <p>{afiche?.frase ?? dia.texto}</p>
          {dia.recorridoConfirmado && (
            <a href={'/2027/?dia=' + dia.id + '#recorridos'} hidden={!hoy}>Ver recorrido</a>
          )}
        </div>
        {afiche?.foto && (
          <Image
            src={afiche.foto.src}
            alt={afiche.foto.alt}
            widths={[480, 800, 1200]}
            sizes="(min-width: 900px) 36vw, 90vw"
            loading="lazy"
            class="parada__foto"
          />
        )}
      </li>
    );
  })}
</ol>

<script>
  import { ANIO } from '../data/carnaval2027';
  import { ahoraEnNavegador, momentoDelCarnaval } from '../lib/fechas';

  const momento = momentoDelCarnaval(ANIO, ahoraEnNavegador());
  document.querySelectorAll<HTMLElement>('[data-parada]').forEach((parada) => {
    const hoy = momento.fase === 'durante' && Number(parada.dataset.parada) === momento.offset;
    if (hoy) parada.setAttribute('aria-current', 'date');
    else parada.removeAttribute('aria-current');

    parada.querySelectorAll<HTMLElement>('.parada__hoy, a').forEach((elemento) => {
      elemento.hidden = !hoy;
    });
  });
</script>

<style>
  .pasacalle {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    list-style: none;
    padding: 0.6rem clamp(0rem, 2vw, 1.5rem);
    isolation: isolate;
  }

  .pasacalle::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 8%;
    background: var(--turquesa);
    clip-path: polygon(4% 7%, 93% 0, 96% 11%, 67% 35%, 99% 58%, 96% 74%, 21% 100%, 14% 89%, 59% 66%, 33% 46%, 0 21%);
  }

  .parada {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--c);
    color: var(--tinta);
    border: 4px solid var(--tinta);
    box-shadow: 5px 6px 0 var(--tinta);
  }

  .parada--sabado { grid-column: 1 / 8; rotate: -1deg; }
  .parada--domingo { grid-column: 8 / -1; rotate: 1deg; margin-top: 1.65rem; }
  .parada--lunes { grid-column: 1 / -1; display: grid; grid-template-columns: 5fr 7fr; }
  .parada--martes { grid-column: 2 / 7; }
  .parada--miercoles { grid-column: 7 / -1; rotate: 0.65deg; margin-top: 1.4rem; }

  .parada--martes {
    background: var(--tinta);
    border-color: var(--turquesa);
    color: var(--blanco);
    box-shadow: none;
  }

  .parada--martes h3 { color: var(--turquesa); }

  .parada__texto {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1rem, 3vw, 2rem);
  }

  .parada__fecha, time {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.65rem;
  }

  time strong, .parada__hoy {
    font: 900 1.3rem/1 var(--display);
    text-transform: uppercase;
  }

  .parada__hoy {
    background: var(--amarillo);
    color: var(--tinta);
    border: 2px solid var(--tinta);
    padding: 0.2rem 0.45rem;
    rotate: -5deg;
  }

  .parada[aria-current='date'] {
    outline: 3px solid var(--amarillo);
    outline-offset: 4px;
  }

  .parada h3 {
    font: 900 clamp(2.05rem, 4vw, 3.8rem)/0.98 var(--display);
    text-wrap: balance;
    text-transform: uppercase;
  }

  .parada--lunes h3 { font-size: clamp(2.7rem, 6vw, 5.6rem); }
  .parada p { max-width: 34ch; font-weight: 650; }
  .parada a { justify-self: start; color: inherit; font-weight: 800; }

  .parada__foto {
    width: 100%;
    height: clamp(9rem, 20vw, 17rem);
    object-fit: cover;
    border-top: 4px solid var(--tinta);
    margin-top: auto;
  }

  .parada--lunes .parada__foto {
    height: 100%;
    max-height: 24rem;
    object-position: center 25%;
    min-height: 15rem;
    border-top: 0;
    border-left: 4px solid var(--tinta);
  }

  @media (max-width: 700px) {
    .pasacalle {
      grid-template-columns: minmax(0, 1fr);
      padding-left: 0.8rem;
    }

    .pasacalle::before {
      inset: 0 auto 0 0;
      width: 1.3rem;
      clip-path: polygon(15% 0, 90% 2%, 72% 38%, 100% 64%, 69% 100%, 0 98%, 23% 62%, 4% 36%);
    }

    .parada {
      grid-column: 1;
      display: flex;
      margin-top: 0;
      rotate: none;
    }

    .parada--lunes .parada__foto {
      height: 12rem;
      min-height: 0;
      border-top: 4px solid var(--tinta);
      border-left: 0;
    }
  }
</style>
