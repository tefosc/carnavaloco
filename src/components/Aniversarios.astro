---
import { idiomaDesdeUrl, t, type Idioma } from '../i18n';

interface Props {
  idioma?: Idioma;
}

const idioma: Idioma = Astro.props.idioma ?? idiomaDesdeUrl(Astro.url);
const txt = t(idioma).aniversarios;
---

<section class="aniversarios bloque fondo-tinta oscuro" data-aniversarios hidden aria-label={txt.proximos}>
  <div class="envoltura aniversarios__grid">
    <p class="aniversarios__titulo" data-aniversarios-titulo></p>
    <ul class="aniversarios__lista" data-aniversarios-lista></ul>
  </div>
</section>

<script>
  import { aplicarAniversarios } from '../lib/aniversarios';

  aplicarAniversarios();
</script>

<style is:global>
  .aniversarios {
    padding-block: clamp(1.8rem, 4vw, 2.6rem);
  }

  .aniversarios__grid {
    display: grid;
    gap: 1.2rem;
  }

  .aniversarios__titulo {
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(1.8rem, 5vw, 2.6rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--amarillo);
  }

  .aniversarios--hoy .aniversarios__titulo {
    color: var(--fucsia);
  }

  .aniversarios__lista {
    list-style: none;
    display: flex;
    gap: 1rem;
    margin-inline: calc(-1 * var(--borde));
    padding: 0.4rem var(--borde) 1.2rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--borde);
    scrollbar-width: thin;
    scrollbar-color: var(--amarillo) transparent;
  }

  .aniversarios__lista > li {
    flex: none;
    scroll-snap-align: start;
  }

  .aniversarios__item {
    display: grid;
    align-content: start;
    gap: 0.1rem;
    width: min(15rem, 68vw);
    min-height: 11.5rem;
    padding: 0.9rem 1.1rem 1.1rem;
    background: var(--c);
    color: var(--tinta);
    border: 3px solid var(--tinta);
    box-shadow: 5px 5px 0 var(--blanco);
    text-decoration: none;
  }

  .aniversarios__item[data-color='azul'] {
    color: var(--blanco);
  }

  .aniversarios__item--hoy {
    outline: 4px solid var(--amarillo);
    outline-offset: 3px;
  }

  .aniversarios__dias {
    font-family: var(--display);
    font-weight: 900;
    font-size: 4.2rem;
    line-height: 0.85;
    color: var(--blanco);
    -webkit-text-stroke: 2px var(--tinta);
    paint-order: stroke fill;
    text-shadow: 3px 3px 0 var(--tinta);
    font-variant-numeric: tabular-nums;
  }

  .aniversarios__unidad {
    min-height: 1.2em;
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .aniversarios__nombre {
    margin-top: 0.4rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.7rem;
    line-height: 0.95;
    text-transform: uppercase;
  }

  .aniversarios__fecha {
    font-weight: 700;
  }

  .aniversarios__item:hover {
    translate: 0 -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .aniversarios__item:hover {
      translate: none;
    }
  }
</style>
