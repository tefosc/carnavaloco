---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { fuentesBarrios } from '../data/barrios';
import { fuentes as fuentesHistoria } from '../data/carnaval';
import { previas } from '../data/carnaval2027';
import { creditoFotos, fotos } from '../data/fotos';
import { fuentesGuia } from '../data/guia';

interface Fuente {
  medio: string;
  titulo?: string;
  url: string;
  nota?: string;
}

const coplas = await getCollection('coplas');
const ediciones = await getCollection('ediciones');
const referenciasCoplas = new Map<string, Fuente>();
for (const { data: copla } of coplas) {
  if (!copla.fuente) continue;
  const anterior = referenciasCoplas.get(copla.fuente.url);
  const verso = copla.versos[0].replace(/[,.;]$/, '');
  referenciasCoplas.set(copla.fuente.url, {
    ...copla.fuente,
    nota: [anterior?.nota, '«' + verso + '»'].filter(Boolean).join(' · '),
  });
}

const programa: Fuente[] = [
  {
    titulo: 'Programa oficial del Carnaval 2026',
    medio: 'Municipalidad Provincial de Cajamarca',
    url: 'https://www.gob.pe/institucion/municajamarca/noticias/1334566-programa-oficial-del-carnaval-2026',
    nota: 'Calendario oficial de la edición anterior.',
  },
  ...previas.flatMap((previa) => previa.fuente ? [{
    titulo: previa.titulo,
    medio: 'Anuncio oficial',
    url: previa.fuente,
  }] : []),
  { titulo: 'OpenStreetMap', medio: 'Colaboradores de OpenStreetMap', url: 'https://www.openstreetmap.org/copyright', nota: 'Calles y datos cartográficos de los recorridos.' },
  { titulo: 'OpenFreeMap', medio: 'OpenFreeMap', url: 'https://openfreemap.org', nota: 'Mapa base del recorrido en 3D.' },
  { titulo: 'OpenMapTiles', medio: 'OpenMapTiles', url: 'https://www.openmaptiles.org/', nota: 'Cartografía vectorial del mapa en 3D.' },
  { titulo: 'Mapterhorn', medio: 'Mapterhorn', url: 'https://mapterhorn.com/attribution', nota: 'Relieve del mapa en 3D.' },
];

const secciones = [
  { id: 'programa', titulo: 'Programa y recorridos', descripcion: 'Calendarios oficiales y datos del mapa.', fuentes: programa },
  { id: 'barrios', titulo: 'Barrios y centros poblados', descripcion: 'Ordenanzas y notas sobre los barrios y sus tradiciones.', fuentes: fuentesBarrios },
  { id: 'historia', titulo: 'Historia y tradiciones', descripcion: 'Documentos y reportajes sobre el origen, los personajes y las costumbres.', fuentes: fuentesHistoria },
  {
    id: 'ediciones',
    titulo: 'Ediciones del carnaval',
    descripcion: 'Referencias sobre los hechos, cifras y protagonistas de cada año.',
    grupos: ediciones.map(({ data }) => data).sort((a, b) => b.anio - a.anio).map((edicion) => ({
      id: 'edicion-' + edicion.anio, titulo: String(edicion.anio), fuentes: edicion.fuentes,
    })),
  },
  {
    id: 'guia',
    titulo: 'Guía para visitantes',
    descripcion: 'Transporte, altura, clima, salud y emergencias. Las marcadas «Verifícalo» en la guía son fuentes débiles o no leídas completas.',
    fuentes: fuentesGuia.map((f) => ({ medio: f.medio, titulo: f.titulo, url: f.url, nota: f.fecha })),
  },
  { id: 'coplas', titulo: 'Coplas tradicionales', descripcion: 'Publicaciones donde se recogieron los versos del cancionero.', fuentes: [...referenciasCoplas.values()] },
  {
    id: 'creditos',
    titulo: 'Fotos y créditos',
    descripcion: 'Fotografías de Pitxiquin en Wikimedia Commons.',
    fuentes: Object.values(fotos).map((foto) => ({
      titulo: foto.alt,
      medio: creditoFotos.autor,
      url: creditoFotos.enlace(foto.archivo),
    })),
  },
];

const referencias = new Map<string, string>();
function prepararFuentes(fuentes: Fuente[]) {
  const unicas = new Map(fuentes.map((fuente) => [fuente.url, fuente]));
  return [...unicas.values()].map((fuente) => {
    const referencia = referencias.get(fuente.url);
    const id = referencia ?? 'referencia-' + (referencias.size + 1);
    referencias.set(fuente.url, id);
    return { ...fuente, id: referencia ? undefined : id, enlace: referencia ? '#' + referencia : fuente.url };
  });
}

const archivo = secciones.map((seccion) => ({
  ...seccion,
  lista: seccion.fuentes ? prepararFuentes(seccion.fuentes) : [],
  grupos: seccion.grupos?.map((grupo) => ({ ...grupo, lista: prepararFuentes(grupo.fuentes) })),
}));
---

<Base og="fuentes" title="Fuentes y créditos" description="Fuentes del programa, mapas, barrios, ediciones y coplas del Carnaval de Cajamarca. Créditos de las fotografías.">
  <header class="encabezado" data-sin-manchas>
    <div class="envoltura">
      <h1>Fuentes y créditos</h1>
      <p>Consulta los documentos, crónicas y fotografías que usamos en este sitio.</p>
    </div>
  </header>

  <div class="envoltura archivo">
    <nav aria-label="Apartados de fuentes" class="indice">
      <ul>
        {archivo.map((seccion) => <li><a href={'#' + seccion.id}>{seccion.titulo}</a></li>)}
      </ul>
    </nav>
    <div class="apartados">
      {archivo.map((seccion) => (
        <section id={seccion.id} aria-labelledby={'titulo-' + seccion.id} data-sin-manchas>
          <h2 id={'titulo-' + seccion.id}>{seccion.titulo}</h2>
          <p class="descripcion">{seccion.descripcion}</p>
          {seccion.id === 'creditos' && (
            <p class="licencia">Algunas fotos están recortadas. <a href={creditoFotos.licenciaUrl}>Licencia {creditoFotos.licencia}</a>.</p>
          )}
          {seccion.lista.length > 0 && (
            <ul class="referencias">
              {seccion.lista.map((fuente) => (
                <li id={fuente.id}>
                  <a href={fuente.enlace}>{fuente.titulo ?? fuente.medio}</a>
                  {fuente.titulo && <span>{fuente.medio}</span>}
                  {fuente.nota && <p>{fuente.nota}</p>}
                </li>
              ))}
            </ul>
          )}
          {seccion.grupos?.map((grupo) => (
            <details id={grupo.id}>
              <summary>{grupo.titulo}</summary>
              <ul class="referencias">
                {grupo.lista.map((fuente) => (
                  <li id={fuente.id}>
                    <a href={fuente.enlace}>{fuente.titulo ?? fuente.medio}</a>
                    {fuente.titulo && <span>{fuente.medio}</span>}
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  function abrirReferencia() {
    const destino = document.getElementById(location.hash.slice(1));
    const grupo = destino?.closest('details');
    if (!grupo || grupo.open) return;
    grupo.open = true;
    destino?.scrollIntoView();
  }

  abrirReferencia();
  addEventListener('hashchange', abrirReferencia);
</script>

<style>
  .encabezado {
    padding-block: clamp(3rem, 7vw, 6.5rem);
    background: var(--tinta);
    color: var(--blanco);
    border-bottom: 8px solid var(--amarillo);
  }

  h1 {
    font-size: clamp(3.5rem, 9vw, 7rem);
    color: var(--amarillo);
    text-transform: uppercase;
    line-height: 0.94;
    text-wrap: balance;
  }

  .encabezado p {
    max-width: 52ch;
    margin-top: 1rem;
    font-size: 1.05rem;
  }

  .archivo {
    display: grid;
    grid-template-columns: minmax(10rem, 1fr) minmax(0, 3fr);
    gap: clamp(2rem, 7vw, 6rem);
    padding-block: clamp(2rem, 5vw, 5rem) clamp(3rem, 8vw, 7rem);
  }

  .indice {
    align-self: start;
    position: sticky;
    top: 1.25rem;
  }

  .indice ul,
  .referencias {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .indice a {
    display: block;
    padding: 0.62rem 0;
    font-weight: 750;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }

  .apartados { min-width: 0; }
  section + section { margin-top: clamp(2.8rem, 5vw, 4.25rem); }

  h2 {
    font-size: clamp(2.1rem, 4.1vw, 3.7rem);
    text-transform: uppercase;
    line-height: 1;
  }

  .descripcion { margin-block: 0.6rem 1.1rem; }
  .licencia { margin-block: 0 1rem; }

  .referencias li {
    display: grid;
    gap: 0.15rem;
    padding-block: 0.75rem;
    border-top: 1px solid color-mix(in srgb, var(--tinta) 20%, transparent);
    overflow-wrap: anywhere;
  }

  .referencias a {
    justify-self: start;
    font-weight: 750;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .referencias span,
  .referencias p {
    font-size: 0.92rem;
    color: color-mix(in srgb, var(--tinta) 86%, var(--blanco));
  }

  .referencias li:target { background: color-mix(in srgb, var(--amarillo) 25%, var(--blanco)); }

  details {
    border-top: 1px solid color-mix(in srgb, var(--tinta) 24%, transparent);
  }

  summary {
    padding: 0.6rem 0.35rem;
    cursor: pointer;
    font-family: var(--display);
    font-size: 1.55rem;
    font-weight: 900;
  }

  summary::marker { color: var(--azul); }
  summary:hover,
  summary:focus-visible { background: color-mix(in srgb, var(--amarillo) 25%, var(--blanco)); }
  details .referencias { padding-inline: 1rem; }

  @media (max-width: 740px) {
    .archivo { grid-template-columns: minmax(0, 1fr); }
    .indice { position: static; }
    .indice ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 1rem;
      padding-block: 0.35rem;
      border-block: 1px solid color-mix(in srgb, var(--tinta) 24%, transparent);
    }
  }
</style>
