---
import Base from '../../layouts/Base.astro';
import CabezaPagina from '../../components/CabezaPagina.astro';
import Estandarte from '../../components/Estandarte.astro';
import Aniversarios from '../../components/Aniversarios.astro';
import InvitacionBarrio from '../../components/InvitacionBarrio.astro';
import { barrios, centrosPoblados, fuentesBarrios } from '../../data/barrios';
import { enlaceWhatsapp } from '../../lib/whatsapp';

const textoBuscable = (barrio: (typeof barrios)[number]) =>
  [barrio.nombre, barrio.apodo, barrio.sector].filter(Boolean).join(' ');
const enlaceBarrioFaltante = enlaceWhatsapp('Mi barrio no aparece en la web del carnaval: ');
---

<Base
  og="barrios"
  title="Barrios"
  description="Los barrios del Carnaval de Cajamarca: sus 24 sectores con su aniversario, sus lemas, sus apodos, reinas y rivalidades."
>
  <CabezaPagina titulo="Barrios" fondo="var(--turquesa)" relleno="var(--amarillo)" sombra="var(--tinta)">
    <p>
      El carnaval se juega por barrio. En 2025 salieron 37, cada uno con sus patrullas, sus comparsas, su reina y un lema
      que se canta a manera de copla.
    </p>
  </CabezaPagina>

  <Aniversarios />

  <section class="bloque pared" aria-labelledby="titulo-pared">
    <div class="envoltura">
      <h2 id="titulo-pared" class="titulo-bloque">Busca tu barrio</h2>

      <div class="buscador">
        <label class="buscador__etiqueta" for="buscar-barrio">Nombre del barrio</label>
        <input
          id="buscar-barrio"
          class="buscador__campo"
          type="search"
          placeholder="Por ejemplo: San Pedro"
          autocomplete="off"
          data-buscador
        />
      </div>

      <ul class="pared__lista">
        {
          barrios.map((barrio) => (
            <li class="pared__item" data-buscar={textoBuscable(barrio)}>
              <Estandarte barrio={barrio} />
            </li>
          ))
        }
      </ul>

      <div class="pared__vacio" data-sin-resultados hidden>
        <p class="entrada">No encontramos ese barrio. Cuéntanos cuál es y lo agregamos.</p>
        <a class="boton" href={enlaceBarrioFaltante} data-enlace-base={enlaceBarrioFaltante} target="_blank" rel="noopener">
          Avisar por WhatsApp
        </a>
      </div>
    </div>
  </section>

  <section class="bloque fondo-tinta oscuro pueblos" aria-labelledby="titulo-pueblos">
    <div class="envoltura pueblos__grid">
      <div>
        <h2 id="titulo-pueblos" class="titulo-bloque">Pueblos y caseríos</h2>
        <dl class="pueblos__lista">
          {
            centrosPoblados.map((centro) => (
              <div>
                <dt>{centro.nombre}</dt>
                {centro.texto && <dd>{centro.texto}</dd>}
              </div>
            ))
          }
        </dl>
      </div>
      <InvitacionBarrio
        pregunta="¿Eres de un pueblo o caserío que sale en el carnaval?"
        mensaje="Soy de un pueblo que sale en el carnaval y quiero que aparezca en la web: "
      />
    </div>
  </section>

  <section class="bloque fuentes-barrios" aria-labelledby="titulo-fuentes-barrios">
    <div class="envoltura">
      <h2 id="titulo-fuentes-barrios" class="fuentes-barrios__titulo">Fuentes</h2>
      <ul>
        {
          fuentesBarrios.map((fuente) => (
            <li>
              <a href={fuente.url}>{fuente.titulo}</a> <span>{fuente.medio}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<script>
  const campo = document.querySelector<HTMLInputElement>('[data-buscador]');
  const items = document.querySelectorAll<HTMLElement>('[data-buscar]');
  const sinResultados = document.querySelector<HTMLElement>('[data-sin-resultados]');
  const enlaceFaltante = sinResultados?.querySelector<HTMLAnchorElement>('[data-enlace-base]');

  const normalizar = (texto: string) =>
    texto
      .normalize('NFD')
      .replace(/\p{Diacritic}/gu, '')
      .toLowerCase()
      .trim();

  function filtrar() {
    if (!campo || !sinResultados || !enlaceFaltante) return;

    const consulta = normalizar(campo.value);
    let visibles = 0;

    items.forEach((item) => {
      const coincide = normalizar(item.dataset.buscar ?? '').includes(consulta);
      item.hidden = !coincide;
      if (coincide) visibles += 1;
    });

    sinResultados.hidden = visibles > 0;
    enlaceFaltante.href = `${enlaceFaltante.dataset.enlaceBase}${encodeURIComponent(campo.value.trim())}`;
  }

  campo?.addEventListener('input', filtrar);
</script>

<style>
  .buscador {
    display: grid;
    gap: 0.4rem;
    max-width: 28rem;
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .buscador__etiqueta {
    font-weight: 700;
  }

  .buscador__campo {
    min-height: 52px;
    padding: 0.6rem 1rem;
    border: 3px solid var(--tinta);
    background: var(--blanco);
    color: var(--tinta);
    font: inherit;
    font-size: 1.1rem;
  }

  .pared__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.2rem 0.9rem;
  }

  .pared__item:nth-child(odd) {
    rotate: -1deg;
  }

  .pared__item:nth-child(even) {
    rotate: 1deg;
  }

  .pared__vacio {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: 2rem;
  }

  .pueblos__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem 4rem;
    align-items: start;
  }

  .pueblos__lista {
    display: grid;
    gap: 1.4rem;
    margin: 0;
  }

  .pueblos__lista dt {
    font-family: var(--display);
    font-weight: 900;
    font-size: 2rem;
    text-transform: uppercase;
    color: var(--fucsia);
  }

  .pueblos__lista dd {
    margin: 0.2rem 0 0;
  }

  .fuentes-barrios__titulo {
    margin-bottom: 1.2rem;
    font-size: 2rem;
    text-transform: uppercase;
  }

  .fuentes-barrios ul {
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  .fuentes-barrios span {
    font-size: 0.9rem;
    font-weight: 600;
    opacity: 0.75;
  }

  @media (min-width: 700px) {
    .pared__lista {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.6rem 1.4rem;
    }
  }

  @media (min-width: 1000px) {
    .pared__lista {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 860px) {
    .pueblos__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pared__item {
      rotate: none;
    }
  }
</style>
