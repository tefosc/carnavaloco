---
import Base from '../layouts/Base.astro';
import Chicha from '../components/Chicha.astro';
import Sello from '../components/Sello.astro';
import Pintura from '../components/Pintura.astro';
import MapaRecorridos from '../components/MapaRecorridos.astro';
import { ANIO, programaOficial, dias, previas, consejos } from '../data/carnaval2027';
import { diaDeCarnaval, inicioEnPeru } from '../lib/fechas';

const formatoDia = new Intl.DateTimeFormat('es-PE', { weekday: 'long', timeZone: 'UTC' });
const formatoNumero = new Intl.DateTimeFormat('es-PE', { day: 'numeric', timeZone: 'UTC' });
const formatoMes = new Intl.DateTimeFormat('es-PE', { month: 'long', timeZone: 'UTC' });

const programa = dias.map((d) => {
  const fecha = diaDeCarnaval(ANIO, d.offset);
  return { ...d, semana: formatoDia.format(fecha), numero: formatoNumero.format(fecha), mes: formatoMes.format(fecha) };
});

const inicio = diaDeCarnaval(ANIO, -4);
const fin = diaDeCarnaval(ANIO, 0);
const faltan = Math.max(0, Math.ceil((inicioEnPeru(inicio) - Date.now()) / 86_400_000));

// Google Calendar: un solo evento de día completo; la fecha final no se incluye.
const aIcs = (d: Date) => d.toISOString().slice(0, 10).replaceAll('-', '');
const googleCalendar = new URL('https://calendar.google.com/calendar/render');
googleCalendar.searchParams.set('action', 'TEMPLATE');
googleCalendar.searchParams.set('text', `Carnaval de Cajamarca ${ANIO}`);
googleCalendar.searchParams.set('dates', `${aIcs(inicio)}/${aIcs(diaDeCarnaval(ANIO, 1))}`);
googleCalendar.searchParams.set('location', 'Cajamarca, Perú');
googleCalendar.searchParams.set('details', `Programa día por día: ${new URL(`/${ANIO}/`, Astro.site)}`);
---

<Base
  og="2027"
  title={`Carnaval ${ANIO}`}
  description={`Carnaval de Cajamarca ${ANIO}: del sábado 6 al miércoles 10 de febrero. Programa día por día, horarios, lugares, actividades previas y consejos para ir.`}
>
  <section class="portada-2027 bloque fondo-tinta oscuro zigzag-abajo" data-pintura aria-labelledby="titulo-2027">
    <div class="capa-pintura" data-capa-pintura aria-hidden="true"></div>
    <div class="envoltura portada-2027__grid">
      <div>
        <p class="portada-2027__antes">Se viene el</p>
        <h1 id="titulo-2027" class="portada-2027__titulo">
          <span class="visualmente-oculto">Carnaval de Cajamarca</span>
          <Chicha
            texto={String(ANIO)}
            class="portada-2027__anio"
            relleno="var(--amarillo)"
            relleno2="var(--naranja)"
            sombra="var(--fucsia)"
            contorno="var(--blanco)"
          />
        </h1>
        <p class="portada-2027__fechas">
          Del sábado {formatoNumero.format(inicio)} al miércoles {formatoNumero.format(fin)} de {formatoMes.format(fin)}
        </p>
        <p class="entrada portada-2027__entrada">
          Cinco días de agua, pintura y coplas, más las semanas de pregón, bando y elección de reinas que vienen antes.
        </p>
        <p class:list={['estado', { 'estado--oficial': programaOficial }]}>
          {
            programaOficial
              ? 'Horarios y lugares del programa oficial.'
              : 'Las horas salen en el programa oficial, que la Municipalidad presenta a inicios de enero.'
          }
        </p>
        <div class="agendar">
          <a class="boton" href={googleCalendar.toString()} target="_blank" rel="noopener">Agregar a Google Calendar</a>
          <a class="boton boton--hueco" href={`/carnaval-${ANIO}.ics`} download>Descargar calendario</a>
        </div>
      </div>
      <Sello anillo="Carnaval de Cajamarca ✶ Carnaval de Cajamarca ✶ " color="var(--fucsia)" giro={10} class="portada-2027__sello">
        <span class="cuenta__numero" data-cuenta-dias>{faltan}</span>
        <span class="cuenta__texto">días</span>
      </Sello>
    </div>
    <Pintura />
  </section>

  <section class="bloque programa" aria-labelledby="titulo-programa">
    <div class="envoltura">
      <h2 id="titulo-programa" class="titulo-bloque">Día por día</h2>
      <ol class="agenda">
        {
          programa.map((d) => (
            <li class="agenda__dia" data-color={d.color}>
              <p class="agenda__fecha">
                <span class="agenda__semana">{d.semana}</span>
                <span class="agenda__numero">{d.numero}</span>
                <span class="agenda__mes">{d.mes}</span>
              </p>
              <div class="agenda__que">
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
                <p class="agenda__antes">{d.antes}</p>
              </div>
              <dl class="agenda__datos">
                <div>
                  <dt>Hora</dt>
                  <dd class:list={{ 'por-confirmar': !d.hora }}>{d.hora ?? 'Por confirmar'}</dd>
                </div>
                <div>
                  <dt>Dónde</dt>
                  <dd>{d.lugar}</dd>
                </div>
              </dl>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bloque fondo-blanco recorridos" aria-labelledby="titulo-recorridos">
    <div class="envoltura">
      <h2 id="titulo-recorridos" class="titulo-bloque">Por dónde pasa</h2>
      <MapaRecorridos />
    </div>
  </section>

  <section class="bloque fondo-amarillo previas" aria-labelledby="titulo-previas">
    <div class="envoltura">
      <h2 id="titulo-previas" class="titulo-bloque">Antes del sábado</h2>
      <ol class="previas__lista">
        {
          previas.map((p) => (
            <li>
              <p class="previas__cuando">{p.fecha ?? p.cuando}</p>
              <h3>{p.titulo}</h3>
              <p>{p.texto}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="bloque fondo-verde consejos zigzag-arriba" aria-labelledby="titulo-consejos">
    <div class="envoltura">
      <h2 id="titulo-consejos" class="titulo-bloque">Si vas</h2>
      <ul class="consejos__lista">
        {
          consejos.map((c) => (
            <li>
              <h3>{c.titulo}</h3>
              <p>{c.texto}</p>
            </li>
          ))
        }
      </ul>
      <div class="consejos__mas">
        <a class="boton" href="/la-fiesta/">Ver personajes y costumbres</a>
        <a class="boton boton--hueco" href="/ediciones/">Ver carnavales anteriores</a>
      </div>
    </div>
  </section>
</Base>

<script>
  import { diaDeCarnaval, inicioEnPeru } from '../lib/fechas';

  const el = document.querySelector<HTMLElement>('[data-cuenta-dias]');
  if (el) {
    const faltan = Math.ceil((inicioEnPeru(diaDeCarnaval(2027, -4)) - Date.now()) / 86_400_000);
    el.textContent = faltan > 0 ? String(faltan) : '¡Ya!';
  }
</script>

<style>
  /* ---------- Portada 2027 ---------- */
  .portada-2027 {
    padding-top: clamp(5rem, 9vw, 6.5rem);
    cursor: crosshair;
  }

  .portada-2027__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem 3rem;
    align-items: center;
  }

  .portada-2027__antes {
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    text-transform: uppercase;
    color: var(--fucsia);
  }

  .portada-2027 :global(.portada-2027__anio) {
    font-size: clamp(7rem, 26vw, 19rem);
  }

  .portada-2027__fechas {
    margin-top: 1.4rem;
    font-family: var(--display);
    font-weight: 900;
    font-size: clamp(2rem, 4.4vw, 3.6rem);
    line-height: 1;
    text-transform: uppercase;
    color: var(--amarillo);
  }

  .portada-2027__entrada {
    margin-top: 1.2rem;
  }

  .estado {
    display: inline-block;
    margin-top: 1.6rem;
    padding: 0.5rem 0.9rem;
    border: 3px dashed var(--amarillo);
    font-weight: 700;
    max-width: 52ch;
  }

  .agendar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  .estado--oficial {
    border-style: solid;
    background: var(--amarillo);
    color: var(--tinta);
  }

  .cuenta__numero {
    font-size: clamp(2.8rem, 5vw, 4rem);
    font-weight: 900;
    font-variant-numeric: tabular-nums;
  }

  .cuenta__texto {
    font-size: 1.1rem;
  }

  /* ---------- Agenda ---------- */
  .agenda {
    list-style: none;
  }

  .agenda__dia {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 1.2rem 2.5rem;
    padding-block: 2rem;
    border-top: 6px solid var(--tinta);
  }

  .agenda__dia:last-child {
    border-bottom: 6px solid var(--tinta);
  }

  .agenda__fecha {
    display: grid;
    align-content: start;
    justify-items: start;
    font-family: var(--display);
    font-weight: 900;
    line-height: 0.85;
    text-transform: uppercase;
  }

  .agenda__semana {
    padding: 0.2rem 0.5rem 0.1rem;
    background: var(--c);
    font-size: 1.3rem;
  }

  .agenda__numero {
    font-size: clamp(5rem, 9vw, 7.5rem);
    color: var(--c);
    -webkit-text-stroke: 0.035em var(--tinta);
    paint-order: stroke fill;
  }

  .agenda__mes {
    font-size: 1.5rem;
  }

  .agenda__que {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .agenda__que h3 {
    font-size: clamp(2rem, 3.4vw, 2.8rem);
    text-transform: uppercase;
  }

  .agenda__antes {
    font-size: 0.98rem;
    padding-left: 0.8rem;
    border-left: 4px solid var(--c);
  }

  .agenda__datos {
    display: grid;
    gap: 1rem;
    align-content: start;
    margin: 0;
  }

  .agenda__datos dt {
    font-weight: 700;
    font-size: 0.9rem;
  }

  .agenda__datos dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
  }

  .agenda__datos div:first-child dd {
    font-family: var(--display);
    font-weight: 900;
    font-size: 1.9rem;
    line-height: 1;
    text-transform: uppercase;
  }

  .por-confirmar {
    justify-self: start;
    display: inline-block;
    padding: 0.25rem 0.5rem 0.15rem;
    background: repeating-linear-gradient(-45deg, var(--amarillo) 0 10px, var(--blanco) 10px 20px);
    border: 3px solid var(--tinta);
  }

  /* ---------- Previas ---------- */
  .previas__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem 2.5rem;
  }

  .previas__lista li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1rem;
    border-top: 6px solid var(--tinta);
  }

  .previas__cuando {
    justify-self: start;
    padding: 0.15rem 0.55rem;
    background: var(--tinta);
    color: var(--amarillo);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .previas__lista h3 {
    font-size: clamp(1.8rem, 2.8vw, 2.3rem);
    text-transform: uppercase;
  }

  /* ---------- Consejos ---------- */
  .consejos__lista {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.5rem;
  }

  .consejos__lista li {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .consejos__lista h3 {
    justify-self: start;
    padding: 0.25rem 0.55rem 0.15rem;
    background: var(--tinta);
    color: var(--blanco);
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    text-transform: uppercase;
  }

  .consejos__mas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 3.5rem;
  }

  @media (max-width: 900px) {
    .portada-2027__grid {
      grid-template-columns: 1fr;
    }

    .agenda__dia {
      grid-template-columns: 7rem minmax(0, 1fr);
    }

    .agenda__datos {
      grid-column: 2;
    }

    .previas__lista,
    .consejos__lista {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .agenda__dia {
      grid-template-columns: 1fr;
    }

    .agenda__fecha {
      display: flex;
      align-items: baseline;
      gap: 0.6rem;
    }

    .agenda__datos {
      grid-column: auto;
    }

    .previas__lista,
    .consejos__lista {
      grid-template-columns: 1fr;
    }
  }
</style>
