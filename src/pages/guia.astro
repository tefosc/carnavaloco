---
import Base from '../layouts/Base.astro';
import CabezaPagina from '../components/CabezaPagina.astro';
import { secciones, revisadoEn } from '../data/guia';
---

<Base
  og="guia"
  title="Guía para visitantes"
  description="Cómo llegar a Cajamarca, dónde quedarse, la altura y el clima de febrero, qué llevar al carnaval, reglas y teléfonos de emergencia, con la fuente de cada dato."
>
  <CabezaPagina titulo="Guía" fondo="var(--azul)" tintaTexto="var(--blanco)" relleno="var(--amarillo)" sombra="var(--fucsia)">
    <p>
      Para quien viene de fuera: cómo llegar, dónde quedarse, qué esperar del clima y la altura, qué llevar y a quién
      llamar. Cada dato dice de dónde sale.
    </p>
    <p class="guia__revision">Revisada el {revisadoEn}. Horarios y precios cambian cada año: confírmalos antes de viajar.</p>
  </CabezaPagina>

  <nav class="guia__indice bloque" aria-label="Secciones de la guía">
    <div class="envoltura">
      <ul>
        {
          secciones.map((s) => (
            <li>
              <a href={`#${s.id}`} data-color={s.color}>
                {s.titulo}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  {
    secciones.map((s) => (
      <section
        id={s.id}
        class:list={['bloque guia__seccion', `fondo-${s.color}`, { oscuro: s.color === 'azul' }]}
        aria-labelledby={`titulo-${s.id}`}
      >
        <div class="envoltura">
          <h2 id={`titulo-${s.id}`} class="titulo-bloque">
            {s.titulo}
          </h2>
          <p class="lectura guia__intro">{s.intro}</p>
          <ul class="guia__datos">
            {s.datos.map((d) => (
              <li class="guia__dato claro">
                <h3>{d.titulo}</h3>
                <p>{d.texto}</p>
                {d.verificar && (
                  <p class="guia__verificar">
                    <strong>Verifícalo:</strong> esta información no sale de una fuente oficial leída completa, o cambia seguido.
                  </p>
                )}
                {d.fuente && (
                  <p class="guia__fuente">
                    Fuente:{' '}
                    <a href={d.fuente.url} rel="noopener">
                      {d.fuente.medio}: {d.fuente.titulo}
                    </a>
                    {d.fuente.fecha && <span> ({d.fuente.fecha})</span>}
                  </p>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <section class="bloque guia__cierre" aria-labelledby="titulo-cierre">
    <div class="envoltura">
      <h2 id="titulo-cierre" class="titulo-bloque">¿Falta algo?</h2>
      <p class="lectura">
        Los horarios, el programa oficial y los recorridos de cada día están en la página del carnaval. Todas las fuentes de
        esta guía, con las del resto del sitio, están en «Fuentes».
      </p>
      <p class="guia__enlaces">
        <a class="boton" href="/2027/">Programa 2027</a>
        <a class="boton boton--hueco" href="/fuentes/">Fuentes y créditos</a>
      </p>
    </div>
  </section>
</Base>

<style>
  .guia__revision {
    margin-top: 0.9rem;
    font-size: 0.95rem;
    font-weight: 700;
  }

  .guia__indice {
    padding-block: 1.6rem 0;
  }

  .guia__indice ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
  }

  .guia__indice a {
    display: block;
    min-height: 44px;
    padding: 0.45rem 0.9rem 0.35rem;
    border: 3px solid var(--tinta);
    border-bottom: 10px solid var(--c);
    background: var(--blanco);
    color: var(--tinta);
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.3rem;
    text-decoration: none;
    text-transform: uppercase;
  }

  .guia__indice a:hover {
    background: var(--c);
  }

  .guia__intro {
    margin-bottom: 2.2rem;
    font-weight: 600;
  }

  .guia__datos {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    padding: 0;
  }

  .guia__dato {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: 1.3rem 1.4rem 1.4rem;
    background: var(--blanco);
    color: var(--tinta);
    border: 4px solid var(--tinta);
    box-shadow: 6px 6px 0 var(--tinta);
  }

  .guia__dato h3 {
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    line-height: 1;
    text-transform: uppercase;
  }

  .guia__verificar {
    padding: 0.5rem 0.7rem;
    background: repeating-linear-gradient(-45deg, var(--amarillo) 0 10px, var(--blanco) 10px 20px);
    border: 2px solid var(--tinta);
    font-size: 0.92rem;
  }

  .guia__fuente {
    font-size: 0.88rem;
    overflow-wrap: anywhere;
  }

  .guia__fuente a {
    color: inherit;
  }

  .guia__enlaces {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.6rem;
  }

  @media (max-width: 860px) {
    .guia__datos {
      grid-template-columns: 1fr;
    }
  }
</style>
