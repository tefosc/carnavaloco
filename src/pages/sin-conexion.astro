---
/**
 * La muestra el service worker (integraciones/sin-conexion) cuando no hay señal y
 * la página pedida no está guardada en el teléfono. No sale en buscadores ni en el sitemap.
 */
import Base from '../layouts/Base.astro';
import Chicha from '../components/Chicha.astro';

const guardadas = [
  { url: '/2027/', texto: 'Programa 2027 y mapa de recorridos' },
  { url: '/', texto: 'Inicio' },
  { url: '/la-fiesta/', texto: 'La fiesta: personajes, música y comida' },
  { url: '/coplas/', texto: 'Coplas' },
  { url: '/habla/', texto: 'Habla cajamarquina' },
  { url: '/barrios/', texto: 'Barrios' },
  { url: '/historia/', texto: 'Historia' },
  { url: '/ediciones/', texto: 'Carnavales anteriores' },
];
---

<Base
  title="Sin conexión"
  description="No hay señal y esta página no está guardada en el teléfono."
  indexable={false}
>
  <section class="sin-senal bloque fondo-tinta oscuro" aria-labelledby="titulo-sin-senal">
    <div class="envoltura sin-senal__grid">
      <h1 id="titulo-sin-senal">
        <Chicha texto="Sin señal" relleno="var(--amarillo)" relleno2="var(--naranja)" sombra="var(--fucsia)" class="sin-senal__titulo" />
      </h1>
      <div class="sin-senal__texto">
        <p class="entrada">
          Esta página todavía no está guardada en tu teléfono. Cuando vuelva la señal se abre sola; mientras tanto, estas
          sí funcionan sin internet:
        </p>
        <ul class="sin-senal__lista">
          {
            guardadas.map((p) => (
              <li>
                <a href={p.url}>{p.texto}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .sin-senal {
    min-height: 70vh;
    display: grid;
    align-items: center;
  }

  .sin-senal__grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: center;
  }

  .sin-senal :global(.sin-senal__titulo) {
    font-size: clamp(5rem, 14vw, 11rem);
    line-height: 0.9;
    /* Lugar para la tilde de la Ñ */
    --aire-arriba: 0.2em;
  }

  .sin-senal__lista {
    list-style: none;
    display: grid;
    gap: 0.6rem;
    margin-top: 1.6rem;
    padding: 0;
  }

  .sin-senal__lista a {
    color: var(--amarillo);
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    text-transform: uppercase;
  }

  @media (max-width: 860px) {
    .sin-senal__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
